{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 3.14,
      "texte": "Vous êtes prêts ? C'est parti pour la première épreuve !"
    },
    {
      "debut": 3.14,
      "fin": 4.0,
      "texte": "À vous de jouer !"
    },
    {
      "debut": 14.07,
      "fin": 15.51,
      "texte": "Trop facile !"
    },
    {
      "debut": 15.51,
      "fin": 17.87,
      "texte": "Vous pensez que les 100 kilos c'était quelque chose ?"
    },
    {
      "debut": 17.87,
      "fin": 20.63,
      "texte": "Pour la deuxième épreuve, on passe à 500 kilos !"
    },
    {
      "debut": 20.63,
      "fin": 22.05,
      "texte": "Et attention, ils vont tous essayer !"
    },
    {
      "debut": 22.05,
      "fin": 22.99,
      "texte": "Mais chacun leur tour !"
    },
    {
      "debut": 22.99,
      "fin": 25.11,
      "texte": "Alors qui va réussir à se lever ces 500 kilos ?"
    },
    {
      "debut": 25.11,
      "fin": 27.47,
      "texte": "C'est parti ! On commence par l'ananas !"
    },
    {
      "debut": 30.99,
      "fin": 33.03,
      "texte": "J'abandonne, c'est trop lourd, j'y arrive pas."
    },
    {
      "debut": 33.33,
      "fin": 34.35,
      "texte": "Quelle déception !"
    },
    {
      "debut": 34.35,
      "fin": 36.37,
      "texte": "L'ananas est déjà forfait, d'aise la deuxième épreuve."
    },
    {
      "debut": 36.71,
      "fin": 38.23,
      "texte": "Maintenant, on va voir ce que vaut la patate."
    },
    {
      "debut": 38.45,
      "fin": 39.35,
      "texte": "À son tour !"
    },
    {
      "debut": 39.35,
      "fin": 40.31,
      "texte": "C'est mon tour maintenant."
    },
    {
      "debut": 43.43,
      "fin": 44.99,
      "texte": "C'est ça, les 500 kilos ?"
    },
    {
      "debut": 45.85,
      "fin": 47.23,
      "texte": "On peut passer à la suite !"
    },
    {
      "debut": 47.23,
      "fin": 48.39,
      "texte": "Vous avez vu ça !"
    },
    {
      "debut": 48.39,
      "fin": 50.37,
      "texte": "La suite va être encore plus folle !"
    },
    {
      "debut": 50.37,
      "fin": 52.01,
      "texte": "Place maintenant à Citron !"
    },
    {
      "debut": 52.01,
      "fin": 53.51,
      "texte": "Notre troisième participant !"
    },
    {
      "debut": 53.51,
      "fin": 55.35,
      "texte": "Ça va encore être du gâteau !"
    },
    {
      "debut": 59.64,
      "fin": 62.18,
      "texte": "Et c'est terminé pour l'ananas ! Il est éliminé !"
    },
    {
      "debut": 62.18,
      "fin": 62.96,
      "texte": "Mais attendez !"
    },
    {
      "debut": 62.96,
      "fin": 64.72,
      "texte": "Parce que la finale risque d'être exceptionnelle !"
    },
    {
      "debut": 64.72,
      "fin": 66.66,
      "texte": "D'un côté Citron et de l'autre la patate !"
    },
    {
      "debut": 66.66,
      "fin": 69.04,
      "texte": "Alors, qui va récupérer les 67 millions d'euros ?"
    },
    {
      "debut": 69.04,
      "fin": 70.2,
      "texte": "Rendez-vous en partie 3 !"
    }
