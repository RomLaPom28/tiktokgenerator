{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.02,
      "fin": 2.18,
      "texte": "Oh ! J'glisse ! Aide-moi !"
    },
    {
      "debut": 5.92,
      "fin": 8.5,
      "texte": "Mon amour, tu vas me manquer pour toujours."
    },
    {
      "debut": 11.47,
      "fin": 12.61,
      "texte": "Mais t'es tellement croustillant."
    },
    {
      "debut": 12.79,
      "fin": 15.33,
      "texte": "Tu as laissé des wings pour nos enfants. Merci."
    },
    {
      "debut": 16.57,
      "fin": 19.59,
      "texte": "Mangez mes enfants, papa vous a laissé plein de wings !"
    },
    {
      "debut": 24.39,
      "fin": 26.43,
      "texte": "Maman, c'est trop bon !"
    },
    {
      "debut": 26.43,
      "fin": 27.83,
      "texte": "Ça a un peu le goût de papa."
    },
    {
      "debut": 28.81,
      "fin": 29.87,
      "texte": "Il est où, papa ?"
    },
    {
      "debut": 31.84,
      "fin": 34.02,
      "texte": "Papa est parti travailler à l'étranger."
    },
    {
      "debut": 35.46,
      "fin": 38.18,
      "texte": "En Belgique, il vous a laissé tout ça."
    },
    {
      "debut": 39.6,
      "fin": 41.2,
      "texte": "Je dois nourrir mes enfants."
    },
    {
      "debut": 42.06,
      "fin": 43.54,
      "texte": "Je vais vendre les wings de papa."
    },
    {
      "debut": 46.92,
      "fin": 49.54,
      "texte": "Venez goûter les wings de papa, bien croustillants."
    },
    {
      "debut": 49.78,
      "fin": 51.52,
      "texte": "Et la sauce samouraï, elle est offerte."
    },
    {
      "debut": 51.78,
      "fin": 54.14,
      "texte": "Allez, qui veut encore des wings ? C'est la meilleure sauce."
    },
    {
      "debut": 54.66,
      "fin": 56.52,
      "texte": "Profitez-en, c'est offert aujourd'hui."
    },
    {
      "debut": 57.58,
      "fin": 58.84,
      "texte": "Wesh, c'est meilleur que KFC."
    },
    {
      "debut": 59.48,
      "fin": 61.34,
      "texte": "Madame, mettez-moi 10 !"
    },
    {
      "debut": 64.35,
      "fin": 67.17,
      "texte": "Merci mon amour, grâce à toi je suis riche."
    },
    {
      "debut": 67.39,
      "fin": 68.99,
      "texte": "Nos enfants manqueront jamais de rien."
    },
    {
      "debut": 74.33,
      "fin": 77.49,
      "texte": "D'un petit stand au marché au meilleur resto de wings de Paris."
    },
    {
      "debut": 78.33,
      "fin": 79.91,
      "texte": "Tout ça grâce à mon homme."
    },
    {
      "debut": 84.64,
      "fin": 86.08,
      "texte": "Les meilleurs wings de France."
    },
    {
      "debut": 86.96,
      "fin": 88.48,
      "texte": "Mes affaires marchent très bien."
    },
    {
      "debut": 91.86,
      "fin": 93.66,
      "texte": "Patronne, on a un gros problème !"
    },
    {
      "debut": 93.66,
      "fin": 96.76,
      "texte": "Il n'y a plus une seule wing et un mariage de 300 personnes vient d'arriver !"
    },
    {
      "debut": 99.92,
      "fin": 101.18,
      "texte": "Je fais maintenant !"
    },
    {
      "debut": 107.97,
      "fin": 109.09,
      "texte": "Je crois que j'ai une idée."
    }
