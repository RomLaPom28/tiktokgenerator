{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.11,
      "fin": 2.27,
      "texte": "Je vois, donc tu essaies de m'arnaquer ?"
    },
    {
      "debut": 2.27,
      "fin": 5.29,
      "texte": "Personne ne peut arnaquer le diable, je vais rester ici jusqu'à ce que tu sortes !"
    },
    {
      "debut": 5.29,
      "fin": 8.11,
      "texte": "Vas-y pas de soucis, bah profite bien de la vue, trou de balle !"
    },
    {
      "debut": 16.82,
      "fin": 19.06,
      "texte": "Recule, enfoiré ! Tu ne vas pas m'attraper !"
    },
    {
      "debut": 20.66,
      "fin": 22.92,
      "texte": "Putain Coco, j'ai besoin de toi !"
    },
    {
      "debut": 22.92,
      "fin": 24.84,
      "texte": "Le diable a réussi à rentrer dans ma maison !"
    },
    {
      "debut": 24.84,
      "fin": 29.28,
      "texte": "Là je suis caché dans mon salon derrière une ligne de selle et je sais pas combien de temps elle va tenir !"
    },
    {
      "debut": 29.28,
      "fin": 32.46,
      "texte": "Surtout reste bien derrière la ligne de selle, ne la franchis sous aucun prétexte !"
    },
    {
      "debut": 32.46,
      "fin": 35.22,
      "texte": "Il va essayer de te faire sortir en te séduisant mais résiste !"
    },
    {
      "debut": 35.22,
      "fin": 39.92,
      "texte": "S'il te plait mon chéri, enlève la ligne de selle, j'ai pas envie de salir mes talons, ils sont tout neuf !"
    },
    {
      "debut": 39.92,
      "fin": 43.24,
      "texte": "Ferme-la sale démon ! Je sais que c'est toi qui te cache derrière cette femme, dégage !"
    },
    {
      "debut": 43.76,
      "fin": 46.92,
      "texte": "Bien essayé mais il va falloir être plus technique pour réussir à me piéger !"
    },
    {
      "debut": 46.92,
      "fin": 49.52,
      "texte": "Ne t'inquiète pas, tu ne vas pas pouvoir rester dans ce salon toute ta vie !"
    },
    {
      "debut": 49.52,
      "fin": 52.36,
      "texte": "On verra bien !"
    },
    {
      "debut": 52.36,
      "fin": 57.14,
      "texte": "Ma... Maman c'est vraiment toi ? Tu es mort il y a 20 ans, ça ne peut pas être toi !"
    },
    {
      "debut": 57.14,
      "fin": 61.76,
      "texte": "Si mon fils c'est moi, et je suis bloquée dans ce monde parce que j'ai aussi fait un pacte avec le diable !"
    }
  ],
