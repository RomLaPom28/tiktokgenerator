{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.02,
      "fin": 2.56,
      "texte": "Mon cœur, j'ai envie de me mettre au sport et de mieux manger."
    },
    {
      "debut": 2.8,
      "fin": 4.14,
      "texte": "Mais arrête avec ça, tu es la plus belle comme ça,"
    },
    {
      "debut": 4.14,
      "fin": 6.04,
      "texte": "je n'ai jamais vu une fille aussi belle que toi, et j'aime quand on dorot."
    },
    {
      "debut": 6.2,
      "fin": 6.8,
      "texte": "Oh mon chéri."
    },
    {
      "debut": 7.06,
      "fin": 7.5,
      "texte": "Je t'aime."
    },
    {
      "debut": 8.22,
      "fin": 9.98,
      "texte": "Regardez-la, elle est tellement mince."
    },
    {
      "debut": 10.06,
      "fin": 12.72,
      "texte": "Pour Dorot, c'est trop rigolo, le pire c'est qu'elle pense qu'elle est fraîche."
    },
    {
      "debut": 13.08,
      "fin": 14.68,
      "texte": "Un jour, tu vas briser ses os à force."
    },
    {
      "debut": 16.86,
      "fin": 19.4,
      "texte": "Mon cœur, je peux prendre un petit morceau dans ton assiette."
    },
    {
      "debut": 19.54,
      "fin": 21.0,
      "texte": "Hors de question, j'ai besoin de protéines moi,"
    },
    {
      "debut": 21.06,
      "fin": 23.2,
      "texte": "mais je t'ai déjà dit que tu es la plus belle, comme ça arrête de te prendre la tête."
    },
    {
      "debut": 23.44,
      "fin": 24.32,
      "texte": "Merci de m'aimer chéri."
    },
    {
      "debut": 25.98,
      "fin": 29.42,
      "texte": "Il a oublié son téléphone, je vais le prendre et aller lui rendre."
    },
    {
      "debut": 32.45,
      "fin": 34.39,
      "texte": "Il se moque de moi avec ses potes."
    },
    {
      "debut": 34.51,
      "fin": 37.81,
      "texte": "Et il fait l'hypocrite avec moi en me disant qu'il me trouve belle et que je ne dois pas changer."
    },
    {
      "debut": 37.95,
      "fin": 39.35,
      "texte": "Il m'a trahi, il va me le payer."
    },
    {
      "debut": 39.97,
      "fin": 42.67,
      "texte": "C'est quoi ces messages ? Alors comme ça je suis trop mince ?"
    },
    {
      "debut": 42.67,
      "fin": 43.85,
      "texte": "Mais rend moi mon téléphone déjà."
    },
    {
      "debut": 43.97,
      "fin": 45.59,
      "texte": "Et de toute façon tu le vois toi-même que tu n'es pas normal,"
    },
    {
      "debut": 45.67,
      "fin": 46.81,
      "texte": "tu n'es pas comme les autres, moi j'y peux rien."
    },
    {
      "debut": 46.95,
      "fin": 48.77,
      "texte": "Tu m'as toujours dit que j'étais la plus belle à tes yeux."
    },
    {
      "debut": 48.89,
      "fin": 49.89,
      "texte": "J'ai menti haha."
    },
    {
      "debut": 51.69,
      "fin": 51.97,
      "texte": "Attends."
    },
    {
      "debut": 52.87,
      "fin": 55.37,
      "texte": "Je vais tout faire pour changer, et pas pour le plaire."
    },
    {
      "debut": 55.77,
      "fin": 57.29,
      "texte": "Depuis tout ce temps, je ne mangeais rien pour lui."
    },
    {
      "debut": 57.47,
      "fin": 59.65,
      "texte": "Je voulais qu'il me trouve belle, mais maintenant je vais le faire pour moi."
    },
    {
      "debut": 59.87,
      "fin": 61.49,
      "texte": "Je vais tout faire pour m'aimer moi en premier."
    },
    {
      "debut": 62.61,
      "fin": 63.99,
      "texte": "On commence par le sport."
    },
    {
      "debut": 64.33,
      "fin": 66.09,
      "texte": "Trois séances par semaine, je donne tout."
    },
    {
      "debut": 68.36,
      "fin": 69.68,
      "texte": "Enfin je peux manger à ma faim."
    },
    {
      "debut": 69.88,
      "fin": 71.74,
      "texte": "Et je commence à me sentir mieux dans mon corps."
    },
    {
      "debut": 72.1,
      "fin": 73.76,
      "texte": "L'heure de ma revanche va bientôt sonner."
    }
  ],
