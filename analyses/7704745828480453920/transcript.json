{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 3.64,
      "texte": "Ma chérie, j'ai trouvé le trésor ! Regarde-moi ça, il est rempli d'or !"
    },
    {
      "debut": 3.64,
      "fin": 5.48,
      "texte": "Gabrielle, mon dieu, tu es vivant !"
    },
    {
      "debut": 6.0,
      "fin": 8.58,
      "texte": "Remonte le coffre en premier, on ne peut pas risquer de perdre tout ça !"
    },
    {
      "debut": 8.58,
      "fin": 11.74,
      "texte": "D'accord, envoie-moi la corde !"
    },
    {
      "debut": 11.74,
      "fin": 15.12,
      "texte": "Avec tout cet argent, on va enfin pouvoir se payer la maison de nos rêves !"
    },
    {
      "debut": 15.12,
      "fin": 17.76,
      "texte": "Oui mon chéri, on l'aura bien mérité."
    },
    {
      "debut": 18.14,
      "fin": 21.74,
      "texte": "Ça y est, le coffre est en sécurité ! Attrape la corde, je te remonte !"
    },
    {
      "debut": 21.74,
      "fin": 24.72,
      "texte": "Vas-y, j'ai beaucoup trop froid dans l'eau, je suis à bout de force !"
    },
    {
      "debut": 25.66,
      "fin": 28.86,
      "texte": "Tu pensais vraiment que j'allais partager tout cet or avec toi ?"
    },
    {
      "debut": 28.86,
      "fin": 32.16,
      "texte": "Attends mon cœur, qu'est-ce que tu me racontes ?"
    },
    {
      "debut": 32.16,
      "fin": 36.92,
      "texte": "Merci pour le trésor mon amour, maintenant je vais vivre la vie dont on rêvait sans toi."
    },
    {
      "debut": 44.5,
      "fin": 45.3,
      "texte": "Reviens !"
    },
    {
      "debut": 45.3,
      "fin": 48.72,
      "texte": "Non non non, je ne peux pas mourir ici, je dois récupérer le trésor !"
    },
    {
      "debut": 49.36,
      "fin": 50.72,
      "texte": "Non, reste loin de moi !"
    },
    {
      "debut": 51.54,
      "fin": 52.72,
      "texte": "C'est quoi ce bruit ?"
    },
    {
      "debut": 53.84,
      "fin": 57.14,
      "texte": "Oh non !"
    }
  ],
