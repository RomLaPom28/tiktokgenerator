{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 2.46,
      "texte": "Mon mari croit que je suis moche, grosse erreur."
    },
    {
      "debut": 2.62,
      "fin": 5.6,
      "texte": "Il n'a jamais vu mon vrai visage, et pourtant il m'aime comme un fou."
    },
    {
      "debut": 6.0,
      "fin": 8.92,
      "texte": "Je veux juste être sûre qu'il m'aime pour ce que je suis, pas pour mon physique."
    },
    {
      "debut": 9.3,
      "fin": 11.44,
      "texte": "Encore une journée de test, et après je lui dis tout."
    },
    {
      "debut": 11.88,
      "fin": 13.18,
      "texte": "Allez, on remet le masque !"
    },
    {
      "debut": 13.18,
      "fin": 14.96,
      "texte": "Tiens bon, c'est l'homme de ma vie !"
    },
    {
      "debut": 14.96,
      "fin": 17.9,
      "texte": "Ouh, c'est affreux ! Mais ça passe !"
    },
    {
      "debut": 17.9,
      "fin": 20.66,
      "texte": "Chérie, viens vite, j'ai une grande nouvelle !"
    },
    {
      "debut": 20.66,
      "fin": 22.48,
      "texte": "Quoi ? Tu as gagné au loto ?"
    },
    {
      "debut": 22.48,
      "fin": 25.44,
      "texte": "Mieux ! Le patron m'a appelé, je deviens directeur d'agence."
    },
    {
      "debut": 25.66,
      "fin": 28.06,
      "texte": "Non ? C'est vrai ?"
    },
    {
      "debut": 28.06,
      "fin": 32.24,
      "texte": "Mon amour, c'est incroyable ! Je suis tellement fière de toi !"
    },
    {
      "debut": 32.24,
      "fin": 35.22,
      "texte": "La vendredi, il y a une soirée avec les clients importants."
    },
    {
      "debut": 35.32,
      "fin": 36.36,
      "texte": "Tu viens avec moi ?"
    },
    {
      "debut": 36.36,
      "fin": 39.44,
      "texte": "Oh non ! Avec mon visage, je vais te faire honte devant tout le monde."
    },
    {
      "debut": 39.96,
      "fin": 42.42,
      "texte": "Ne dis pas ça. Moi, ce que j'aime chez toi, c'est ton cœur."
    },
    {
      "debut": 42.8,
      "fin": 45.28,
      "texte": "D'accord, mais je mettrai un joli masque de princesse."
    },
    {
      "debut": 45.56,
      "fin": 49.38,
      "texte": "Arrête ! Viens comme tu es ! Et s'ils ne sont pas contents, tant pis pour eux."
    },
    {
      "debut": 49.72,
      "fin": 54.08,
      "texte": "C'est ça, la femme de Ryan ? On dirait un monstre de film d'horreur !"
    },
    {
      "debut": 54.08,
      "fin": 57.86,
      "texte": "Si je le nomme directeur, sa femme va ruiner l'image de l'agence."
    },
    {
      "debut": 58.2,
      "fin": 60.96,
      "texte": "Un directeur doit se montrer avec une femme magnifique."
    },
    {
      "debut": 61.54,
      "fin": 63.52,
      "texte": "Faites-les venir, tous les deux !"
    },
    {
      "debut": 63.52,
      "fin": 65.98,
      "texte": "Alors Ryan, tu la veux, cette promotion ?"
    },
    {
      "debut": 65.98,
      "fin": 68.2,
      "texte": "Bien sûr, patron. J'ai tout donné pour cette agence."
    },
    {
      "debut": 68.5,
      "fin": 71.64,
      "texte": "Petit problème, chez nous, l'image des épouses compte beaucoup."
    },
    {
      "debut": 72.08,
      "fin": 73.58,
      "texte": "Et la tienne, ce n'est pas possible."
    },
    {
      "debut": 73.92,
      "fin": 75.28,
      "texte": "Attendez, vous êtes sérieux ?"
    },
    {
      "debut": 75.28,
      "fin": 78.6,
      "texte": "Franchement, qui voudrait se montrer avec toi à une soirée ?"
    },
    {
      "debut": 78.6,
      "fin": 79.9,
      "texte": "Ton visage, c'est une honte."
    },
    {
      "debut": 80.74,
      "fin": 83.62,
      "texte": "Alors choisis, le poste et l'argent ou ta femme ?"
    },
    {
      "debut": 83.62,
      "fin": 85.16,
      "texte": "Pas les deux !"
    },
    {
      "debut": 85.16,
      "fin": 89.3,
      "texte": "Gardez votre promotion ! Ma femme, je ne la quitterai jamais !"
    },
    {
      "debut": 89.3,
      "fin": 92.28,
      "texte": "Alors retourne vivre dans ta misère avec elle !"
    },
    {
      "debut": 92.28,
      "fin": 93.42,
      "texte": "Pauvre idiot !"
    },
    {
      "debut": 93.42,
      "fin": 96.2,
      "texte": "Stop ! Ça suffit ! J'en ai assez de vos méchancetés !"
    },
    {
      "debut": 96.2,
      "fin": 99.1,
      "texte": "Oh, le monstre a resparlé ? Et tu vas faire quoi ?"
    },
    {
      "debut": 99.1,
      "fin": 101.36,
      "texte": "Vous voulez voir mon vrai visage ?"
    },
    {
      "debut": 101.36,
      "fin": 103.9,
      "texte": "Regardez bien, parce que vous allez le regretter !"
    }
  ],
