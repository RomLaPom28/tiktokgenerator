  "phrases": [
    {
      "debut": 0.27,
      "fin": 5.81,
      "texte": "marche normalement mon ref cherche le pas du regard je te jure dario fait pas de dinguerie je suis juste venu voir"
    },
    {
      "debut": 7.01,
      "fin": 9.19,
      "texte": "là bas le vert avec zadian c'est ce fauté"
    },
    {
      "debut": 10.37,
      "fin": 12.37,
      "texte": "et ça autour de son cou c'est ma chaîne"
    },
    {
      "debut": 13.83,
      "fin": 16.05,
      "texte": "c'est qui lui attend je crois que c'est son frère"
    },
    {
      "debut": 17.13,
      "fin": 20.83,
      "texte": "la chair que t'as autour du coeur enlève la pourquoi elle est à toi c'est très bien qui elle est et si j'ai pas"
    },
    {
      "debut": 20.83,
      "fin": 25.07,
      "texte": "envie de la rendre fait pas le malin donne la moi sinon quoi tu vas faire quoi devant tout le monde valie"
    },
    {
      "debut": 26.27,
      "fin": 28.35,
      "texte": "non maintenant j'ai envie de voir jusqu'où il va aller"
    },
    {
      "debut": 29.05,
      "fin": 33.15,
      "texte": "qu'est ce qui se passe ici rien madame on discutait il a quelque chose qui m'appartient"
    },
    {
      "debut": 33.15,
      "fin": 37.01,
      "texte": "d'accord mais vous vous restez à l'extérieur t'inquiète on finira la discussion"
    },
    {
      "debut": 39.4,
      "fin": 44.34,
      "texte": "attend dario est vraiment venu au lycée ouais samy l'a appelé sans me prévenir mais vous réfléchissez des fois tous les deux"
    },
    {
      "debut": 44.34,
      "fin": 48.98,
      "texte": "maman calme toi il a rien fait justement avec ton frère c'est quand ils disent rien que je m'inquiète non là tu vas prévenir ton frère"
    },
    {
      "debut": 48.98,
      "fin": 51.3,
      "texte": "samy il dit que caisse veut me voir demain apparemment après ce matin"
    },
    {
      "debut": 51.76,
      "fin": 55.42,
      "texte": "caisse veut me voir demain derrière le gymnase et il t'a demandé de venir seul"
    },
    {
      "debut": 55.42,
      "fin": 61.74,
      "texte": "ouais mais j'irai pas sans quelqu'un non toi tu y vas pas du tout attends tu comptes y aller à ma place"
    },
    {
      "debut": 61.74,
      "fin": 63.92,
      "texte": "oui je vais m'en occuper"
    },
    {
      "debut": 63.92,
      "fin": 67.72,
      "texte": "il t'a dit quoi exactement que demain tu viens seul derrière le gymnase"
    },
    {
      "debut": 68.18,
      "fin": 72.08,
      "texte": "et toi tu comptais venir il m'a dit de rester en dehors de ça"
    },
    {
      "debut": 72.08,
      "fin": 74.92,
      "texte": "ouais donc clairement je vais pas y aller seul"
    },
    {
      "debut": 74.92,
      "fin": 80.92,
      "texte": "ça fait dix minutes il viendra pas si il va venir il a pas le choix depuis hier je te dis que ça sent pas bon"
    },
    {
      "debut": 81.56,
      "fin": 83.24,
      "texte": "attend y'a quelqu'un"
    },
    {
      "debut": 85.93,
      "fin": 86.83,
      "texte": "noé viendra pas"
    },
    {
      "debut": 88.11,
      "fin": 91.25,
      "texte": "c'est moi que tu vas voir t'es vraiment venu tout seul"
    },
    {
      "debut": 91.25,
