{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 2.64,
      "texte": "« Monsieur Damien, pourquoi vous vous peignez en blanc ? »"
    },
    {
      "debut": 2.64,
      "fin": 3.36,
      "texte": "J'en ai marre."
    },
    {
      "debut": 3.48,
      "fin": 5.48,
      "texte": "Les femmes viennent me voir seulement pour mon argent."
    },
    {
      "debut": 5.76,
      "fin": 7.42,
      "texte": "Comme ça, personne ne me reconnaîtra."
    },
    {
      "debut": 7.7,
      "fin": 9.52,
      "texte": "Je veux une femme qui m'aime pour ce que je suis,"
    },
    {
      "debut": 9.74,
      "fin": 10.46,
      "texte": "pas pour mes millions."
    },
    {
      "debut": 10.9,
      "fin": 13.64,
      "texte": "Et comment vous allez savoir si elle est sincère ?"
    },
    {
      "debut": 13.64,
      "fin": 14.16,
      "texte": "Facile."
    },
    {
      "debut": 14.36,
      "fin": 15.54,
      "texte": "Je l'invite dans un petit resto,"
    },
    {
      "debut": 15.84,
      "fin": 18.34,
      "texte": "et au moment de payer, je dis que j'ai que la moitié."
    },
    {
      "debut": 18.56,
      "fin": 20.52,
      "texte": "Et si elle se fâche,"
    },
    {
      "debut": 20.7,
      "fin": 23.72,
      "texte": "alors je saurai comment elle traite un homme sans argent."
    },
    {
      "debut": 23.82,
      "fin": 24.9,
      "texte": "J'ai trouvé quatre candidates."
    },
    {
      "debut": 25.06,
      "fin": 26.2,
      "texte": "La première, c'est Isabelle."
    },
    {
      "debut": 26.32,
      "fin": 27.16,
      "texte": "Elle est libre ce soir."
    },
    {
      "debut": 27.58,
      "fin": 27.98,
      "texte": "Parfait."
    },
    {
      "debut": 28.1,
      "fin": 29.26,
      "texte": "Réserve un petit resto simple."
    },
    {
      "debut": 29.26,
      "fin": 30.38,
      "texte": "Surtout pas un des miens."
    },
    {
      "debut": 30.44,
      "fin": 31.48,
      "texte": "C'est ça, le resto ?"
    },
    {
      "debut": 31.48,
      "fin": 33.22,
      "texte": "Je pensais que tu m'emmènerais dans un endroit chic."
    },
    {
      "debut": 33.42,
      "fin": 34.56,
      "texte": "Tu fais quoi dans la vie ?"
    },
    {
      "debut": 34.56,
      "fin": 35.72,
      "texte": "Je travaille dans une entreprise."
    },
    {
      "debut": 35.96,
      "fin": 37.58,
      "texte": "Je gagne pas beaucoup, mais je m'en sors."
    },
    {
      "debut": 37.92,
      "fin": 39.18,
      "texte": "Isabelle, j'ai que la moitié."
    },
    {
      "debut": 39.38,
      "fin": 40.38,
      "texte": "Tu peux payer le reste ?"
    },
    {
      "debut": 40.38,
      "fin": 42.68,
      "texte": "Quoi ? C'est toi qui m'a invitée !"
    },
    {
      "debut": 42.68,
      "fin": 45.94,
      "texte": "Je sors pas avec un homme qui peut même pas payer un dîner."
    },
    {
      "debut": 46.34,
      "fin": 48.62,
      "texte": "Si seulement elle savait que je peux acheter tout ce restaurant."
    },
    {
      "debut": 48.98,
      "fin": 49.5,
      "texte": "Au suivant."
    }
  ],
