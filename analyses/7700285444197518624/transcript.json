    {
      "debut": 4.88,
      "fin": 6.14,
      "texte": "Je pourrais au moins t'excuser !"
    },
    {
      "debut": 6.14,
      "fin": 7.84,
      "texte": "Quoi ? Tu me parles à moi, petit ?"
    },
    {
      "debut": 8.56,
      "fin": 11.34,
      "texte": "Oh non ! Ce gamin vient de provoquer Tyson !"
    },
    {
      "debut": 11.34,
      "fin": 13.58,
      "texte": "Il ferait mieux de partir avant que ça dégérire !"
    },
    {
      "debut": 14.2,
      "fin": 15.28,
      "texte": "Ça va mal finir."
    },
    {
      "debut": 16.46,
      "fin": 18.18,
      "texte": "Mets-toi à genoux et demande pardon !"
    },
    {
