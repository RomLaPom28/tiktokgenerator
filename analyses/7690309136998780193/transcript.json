{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 3.0,
      "texte": "Mesdames et messieurs, nous y sommes ! La grande finale va commencer !"
    },
    {
      "debut": 3.0,
      "fin": 5.64,
      "texte": "Après l'élimination de l'ananas, la finale oppose Citron à la patate !"
    },
    {
      "debut": 5.64,
      "fin": 8.18,
      "texte": "Citron contre la patate ! 67 millions d'euros sont en jeu !"
    },
    {
      "debut": 8.18,
      "fin": 10.88,
      "texte": "Vous êtes prêt pour le choc final ? C'est parti pour la finale !"
    },
    {
      "debut": 12.16,
      "fin": 14.12,
      "texte": "L'épreuve finale va commencer !"
    },
    {
      "debut": 15.18,
      "fin": 18.02,
      "texte": "Mais avant toute chose, si vous êtes là, c'est que vous aimez le concept."
    },
    {
      "debut": 18.82,
      "fin": 22.12,
      "texte": "Alors abonnez-vous à la chaîne et dites-nous en commentaire quel prochain concours on pourrait organiser."
    },
    {
      "debut": 22.32,
      "fin": 24.22,
      "texte": "L'épreuve finale va se jouer sur le mental."
    },
    {
      "debut": 24.68,
      "fin": 28.04,
      "texte": "Chacun des joueurs devra maintenir au-dessus de sa tête un bloc d'une tonne."
    },
    {
      "debut": 28.06,
      "fin": 29.86,
      "texte": "Le premier qui lâche a perdu !"
    },
    {
      "debut": 29.86,
      "fin": 31.78,
      "texte": "Alors, faites péter les blocs de béton !"
    },
    {
      "debut": 32.86,
      "fin": 34.74,
      "texte": "Regardez-moi, c'est deux monstres qui arrivent !"
    },
    {
      "debut": 34.74,
      "fin": 37.28,
      "texte": "Deux blocs, deux finalistes et une seule chance de rester debout !"
    },
    {
      "debut": 37.28,
      "fin": 39.38,
      "texte": "La patate va devoir prouver que sa puissance n'est pas qu'une blague"
    },
    {
      "debut": 39.38,
      "fin": 41.78,
      "texte": "et notre pétis Citron va devoir nous montrer jusqu'où va sa force."
    },
    {
      "debut": 41.94,
      "fin": 43.62,
      "texte": "Vous pensez qu'ils vont tenir combien de temps ?"
    },
    {
      "debut": 43.62,
      "fin": 45.3,
      "texte": "Allez ! On veut du spectacle !"
    },
    {
      "debut": 45.3,
      "fin": 46.4,
      "texte": "Et c'est parti !"
    },
    {
      "debut": 46.4,
      "fin": 47.32,
      "texte": "Tenez les blocs !"
    },
    {
      "debut": 49.86,
      "fin": 52.04,
      "texte": "C'est la première fois de ma vie que j'arrive à sentir une charge."
    },
    {
      "debut": 52.68,
      "fin": 54.46,
      "texte": "C'est donc ça de sentir quelque chose d'un peu lourd."
    },
    {
      "debut": 55.64,
      "fin": 57.16,
      "texte": "C'est trop lourd, j'en peux plus."
    },
    {
      "debut": 57.44,
      "fin": 58.34,
      "texte": "Je vais plus tenir très longtemps."
    },
    {
      "debut": 59.02,
      "fin": 61.22,
      "texte": "Ça fait actuellement 10 minutes que l'épreuve a commencé."
    },
    {
      "debut": 61.22,
      "fin": 64.1,
      "texte": "Qui tiendra bon jusqu'au bout ? On va vite le savoir !"
    },
    {
      "debut": 65.2,
      "fin": 66.56,
      "texte": "C'est pas possible."
    },
    {
      "debut": 66.82,
      "fin": 67.72,
      "texte": "Tout sorti de cette force."
    },
    {
      "debut": 68.08,
      "fin": 69.38,
      "texte": "Il est tout maigre !"
    },
    {
      "debut": 70.0,
      "fin": 71.28,
      "texte": "Citron, tu as le grand gagnant."
    },
    {
      "debut": 71.48,
      "fin": 72.34,
      "texte": "C'est bon, tu peux lâcher."
    },
    {
      "debut": 72.72,
      "fin": 73.88,
      "texte": "J'avais pas compris."
    },
    {
      "debut": 76.16,
      "fin": 78.7,
      "texte": "Pierre-Pierre veuille applaudir le grand gagnant de ce concours."
    },
    {
      "debut": 79.06,
      "fin": 80.92,
      "texte": "Notre petit Citron !"
    },
    {
      "debut": 80.92,
      "fin": 84.14,
      "texte": "Après avoir résisté à une tonne, il repart avec les 67 millions d'euros."
    },
    {
      "debut": 84.66,
      "fin": 85.5,
      "texte": "Quelle exploit !"
    },
    {
      "debut": 87.58,
      "fin": 89.3,
      "texte": "Merci, frérot, d'avoir cru en moi."
    },
    {
      "debut": 89.3,
      "fin": 91.22,
      "texte": "Maintenant à nous, la belle vie !"
    },
    {
      "debut": 91.22,
      "fin": 92.76,
      "texte": "On l'a fait, frérot !"
    },
    {
      "debut": 92.76,
      "fin": 94.1,
      "texte": "Fini le chantier !"
    }
  ],
