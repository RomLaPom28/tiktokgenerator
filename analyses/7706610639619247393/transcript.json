{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 2.46,
      "texte": "Elle croit que je suis complètement fauché."
    },
    {
      "debut": 2.7,
      "fin": 4.7,
      "texte": "Mais en vrai, je suis l'homme le plus riche de France."
    },
    {
      "debut": 5.22,
      "fin": 8.1,
      "texte": "Demain, après son tout dernier test, je lui dis enfin la vérité."
    },
    {
      "debut": 9.14,
      "fin": 11.38,
      "texte": "Hey, pourquoi tu manges pas tes haricots ?"
    },
    {
      "debut": 11.38,
      "fin": 12.48,
      "texte": "Voilà, ma boîte est vide."
    },
    {
      "debut": 12.76,
      "fin": 15.56,
      "texte": "T'es sûr mon cœur ? Tiens, prends la mienne. J'ai pas trop faim de toute façon."
    },
    {
      "debut": 15.8,
      "fin": 16.7,
      "texte": "Et faut que j'aille me préparer."
    },
    {
      "debut": 16.86,
      "fin": 17.88,
      "texte": "Oui, t'inquiète, sûr et certain."
    },
    {
      "debut": 19.42,
      "fin": 21.38,
      "texte": "Tu vas où comme ça ? Si pressé ?"
    },
    {
      "debut": 21.38,
      "fin": 23.82,
      "texte": "À mon gros entretien d'embauche, je t'en avais parlé !"
    },
    {
      "debut": 23.82,
      "fin": 25.14,
      "texte": "Je peux venir avec toi ?"
    },
    {
      "debut": 25.14,
      "fin": 27.86,
      "texte": "Bien sûr ! Allez, on y va !"
    },
    {
      "debut": 27.86,
      "fin": 30.36,
      "texte": "Hey, pourquoi t'es aussi stressée ?"
    },
    {
      "debut": 30.36,
      "fin": 32.46,
      "texte": "On a vraiment besoin de ce boulot mon amour."
    },
    {
      "debut": 32.74,
      "fin": 34.48,
      "texte": "Juste pour garder un toit au-dessus de nos têtes."
    },
    {
      "debut": 34.74,
      "fin": 36.46,
      "texte": "T'inquiète, tu vas tout niquer ma chérie."
    },
    {
      "debut": 36.96,
      "fin": 39.08,
      "texte": "Madame, Mademoiselle Pechina est arrivée pour son entretien."
    },
    {
      "debut": 39.24,
      "fin": 40.32,
      "texte": "Mais il y a un piment avec elle."
    },
    {
      "debut": 40.4,
      "fin": 41.66,
      "texte": "Il lui tient la main et il la console."
    },
    {
      "debut": 41.86,
      "fin": 43.34,
      "texte": "Ah ouais, et il affiche combien sur son front ?"
    },
    {
      "debut": 43.34,
      "fin": 44.7,
      "texte": "Euh, 12 dollars. 12 dollars."
    },
    {
      "debut": 46.0,
      "fin": 48.94,
      "texte": "Les pauvres avec les pauvres, c'est la base !"
    },
    {
      "debut": 48.94,
      "fin": 52.5,
      "texte": "Faites entrer Mademoiselle Pechina et ramenez son petit mari aussi."
    },
    {
      "debut": 53.66,
      "fin": 55.82,
      "texte": "Madame, la patronne vous attend pour l'entretien."
    },
    {
      "debut": 55.82,
      "fin": 57.84,
      "texte": "Et elle veut que votre mari vienne aussi."
    },
    {
      "debut": 58.08,
      "fin": 59.14,
      "texte": "Attendez, mais pourquoi ?"
    },
    {
      "debut": 59.14,
      "fin": 61.14,
      "texte": "J'en sais rien, c'est un ordre. Suivez-moi."
    },
    {
      "debut": 64.73,
      "fin": 67.81,
      "texte": "Alors Pechina, dites-moi pourquoi vous avez autant besoin de ce poste."
    },
    {
      "debut": 67.93,
      "fin": 70.19,
      "texte": "Pour être honnête, ma famille traverse une énorme crise financière."
    },
    {
      "debut": 70.35,
      "fin": 71.59,
      "texte": "J'ai besoin de ce travail plus que tout."
    },
    {
      "debut": 71.63,
      "fin": 72.95,
      "texte": "Et je vous promets que je ne vous décevrai pas."
    },
    {
      "debut": 73.33,
      "fin": 75.67,
      "texte": "Écoutez, je vous donne le poste avec le double du salaire de départ."
    },
    {
      "debut": 75.79,
      "fin": 76.79,
      "texte": "Mais j'ai une toute petite condition."
    },
    {
      "debut": 77.15,
      "fin": 79.11,
      "texte": "Le double ? C'est quoi la condition madame ?"
    },
    {
      "debut": 79.11,
      "fin": 81.49,
      "texte": "Tu largues ce clochard de piment là, maintenant."
    },
    {
      "debut": 81.79,
      "fin": 82.87,
      "texte": "Tu le vires de ta vie."
    },
    {
      "debut": 83.27,
      "fin": 86.07,
      "texte": "Jamais de la vie, mon homme, je ne l'humilie pas pour un boulot !"
    },
    {
      "debut": 86.07,
      "fin": 88.87,
      "texte": "Très bien. Dehors. Et profite bien de la vie dans la rue."
    },
    {
      "debut": 93.36,
      "fin": 95.86,
      "texte": "Pourquoi t'as refusé, ma belle ? Ça aurait tout réglé."
    },
    {
      "debut": 96.22,
      "fin": 99.86,
      "texte": "Parce que je t'aime. Vraiment. L'argent, je pourrais toujours le gagner plus tard."
    },
    {
      "debut": 100.2,
      "fin": 102.64,
      "texte": "Mais un amour comme le tien, je le retrouverai jamais chez personne."
    },
    {
      "debut": 103.22,
      "fin": 106.42,
      "texte": "Pechina, il y a quelque chose de très important que je dois te dire."
    },
    {
      "debut": 108.0,
      "fin": 108.72,
      "texte": "Quoi ?"
    }
  ],
