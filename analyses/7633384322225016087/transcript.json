{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 3.4,
      "texte": "Ils ne sauront jamais que je suis en réalité une framboise."
    },
    {
      "debut": 3.66,
      "fin": 7.12,
      "texte": "Moi je suis une orange, toi t'es une fraise, alors comment on peut avoir un bébé framboise ?"
    },
    {
      "debut": 7.12,
      "fin": 8.0,
      "texte": "Tu m'as trompé !"
    },
    {
      "debut": 8.0,
      "fin": 8.54,
      "texte": "Non !"
    },
    {
      "debut": 8.54,
      "fin": 10.48,
      "texte": "Je te jure que je ne t'ai pas trompé."
    },
    {
      "debut": 11.7,
      "fin": 13.1,
      "texte": "Crois-moi, s'il te plaît."
    },
    {
      "debut": 13.3,
      "fin": 14.8,
      "texte": "Voici les tests de paternité, monsieur."
    },
    {
      "debut": 15.04,
      "fin": 16.78,
      "texte": "Votre jus correspond, vous êtes bien le père."
    },
    {
      "debut": 17.14,
      "fin": 18.3,
      "texte": "Quoi, mais c'est impossible !"
    },
    {
      "debut": 18.3,
      "fin": 18.82,
      "texte": "Comment ?"
    },
    {
      "debut": 18.82,
      "fin": 20.4,
      "texte": "Fais pas semblant d'être innocente."
    },
    {
      "debut": 20.82,
      "fin": 22.28,
      "texte": "Je vais pas croire un vieux bout de papier."
    },
    {
      "debut": 22.72,
      "fin": 24.48,
      "texte": "Comment je pourrais te prouver mon innocence ?"
    },
    {
      "debut": 24.48,
      "fin": 28.78,
      "texte": "Alors une orange, une fraise, un bébé framboise, les calculs sont pas bons !"
    },
    {
      "debut": 28.78,
      "fin": 30.2,
      "texte": "Allez viens, on rentre."
    },
    {
      "debut": 30.58,
      "fin": 33.76,
      "texte": "Regardez-moi ça, cette femme a forcément mélangé son jus avec un autre."
    },
    {
      "debut": 36.14,
      "fin": 37.78,
      "texte": "J'en peux plus !"
    },
    {
      "debut": 37.78,
      "fin": 40.92,
      "texte": "Appelle tes parents tout de suite, je veux leur parler !"
    },
    {
      "debut": 40.92,
      "fin": 43.66,
      "texte": "Ce bébé peut pas être de moi, elle m'a trompé, je la quitte."
    },
    {
      "debut": 43.86,
      "fin": 46.02,
      "texte": "S'il te plaît, lâche-la pas comme ça, on va s'arranger."
    },
    {
      "debut": 46.2,
      "fin": 49.18,
      "texte": "Très bien, vous me léguez l'entreprise familiale et 50% de votre salaire à vie."
    },
    {
      "debut": 49.28,
      "fin": 51.52,
      "texte": "On fera tout ce que tu veux pour notre fille, pars pas."
    },
    {
      "debut": 51.66,
      "fin": 53.1,
      "texte": "Quelle bande de naïfs."
    },
    {
      "debut": 53.28,
      "fin": 55.3,
      "texte": "C'était plus facile que je le pensais."
    },
    {
      "debut": 55.46,
      "fin": 56.92,
      "texte": "Bientôt tout leur bien sera à moi."
    },
    {
      "debut": 57.08,
      "fin": 57.78,
      "texte": "J'ai tout entendu."
    },
    {
      "debut": 58.3,
      "fin": 61.22,
      "texte": "C'est terminé, tu vas devoir aller donner des explications à mes parents maintenant."
    }
  ],
