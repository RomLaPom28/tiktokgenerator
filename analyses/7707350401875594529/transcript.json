{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 3.32,
      "texte": "Je suis mannequin, mais mon fiancé croit que je pèse 150 kilos."
    },
    {
      "debut": 3.96,
      "fin": 5.8,
      "texte": "Ce soir, je saurais s'il m'aime vraiment."
    },
    {
      "debut": 6.28,
      "fin": 9.66,
      "texte": "Frérot, c'est elle, ta fiancée ? T'as perdu un pari ou quoi ?"
    },
    {
      "debut": 9.66,
      "fin": 10.9,
      "texte": "Laisse-la tranquille, Karim."
    },
    {
      "debut": 11.26,
      "fin": 13.34,
      "texte": "T'as pas honte de moi ?"
    },
    {
      "debut": 13.34,
      "fin": 15.56,
      "texte": "Tu vas finir toutes les assiettes, toi ?"
    },
    {
      "debut": 15.56,
      "fin": 18.08,
      "texte": "Maman, tu parles à ma future femme. Respecte-la."
    },
    {
      "debut": 18.46,
      "fin": 19.36,
      "texte": "Merci, mon cœur."
    },
    {
      "debut": 20.66,
      "fin": 22.54,
      "texte": "Mon fils mérite une femme qu'il peut montrer."
    },
    {
      "debut": 23.24,
      "fin": 23.86,
      "texte": "Pas ça."
    },
    {
      "debut": 24.12,
      "fin": 26.0,
      "texte": "Votre fils m'aime comme je suis, madame."
    },
    {
      "debut": 27.58,
      "fin": 29.62,
      "texte": "Il m'a défendue devant sa mère, Inès !"
    },
    {
      "debut": 29.62,
      "fin": 30.8,
      "texte": "Il m'aime vraiment !"
    },
    {
      "debut": 30.8,
      "fin": 31.56,
      "texte": "Alors arrête ce test."
    },
    {
      "debut": 32.1,
      "fin": 32.98,
      "texte": "Montre-lui la vraie Jade."
    },
    {
      "debut": 35.06,
      "fin": 36.84,
      "texte": "On n'a rien dans votre taille, madame."
    },
    {
      "debut": 37.1,
      "fin": 37.78,
      "texte": "Vous inquiétez pas."
    },
    {
      "debut": 38.3,
      "fin": 39.82,
      "texte": "Le jour G, elle m'ira parfaitement."
    },
    {
      "debut": 42.26,
      "fin": 43.2,
      "texte": "Ce soir, j'enlève tout."
    },
    {
      "debut": 43.68,
      "fin": 44.24,
      "texte": "Fini le test."
    },
    {
      "debut": 44.62,
      "fin": 46.22,
      "texte": "Il va enfin rencontrer la vraie Jade."
    },
    {
      "debut": 49.42,
      "fin": 50.14,
      "texte": "T'inquiètes, Karim."
    },
    {
      "debut": 50.76,
      "fin": 51.54,
      "texte": "Son père a des millions."
    },
    {
      "debut": 51.96,
      "fin": 53.76,
      "texte": "Une fois mariée, je la quitte."
    }
