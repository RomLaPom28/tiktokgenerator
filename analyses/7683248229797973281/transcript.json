{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 1.94,
      "texte": "Lâchez-moi ! Elle va me le payer !"
    },
    {
      "debut": 1.94,
      "fin": 3.48,
      "texte": "Comment on va faire pour Doro maintenant ?"
    },
    {
      "debut": 3.48,
      "fin": 4.66,
      "texte": "On va y de toute façon !"
    },
    {
      "debut": 6.28,
      "fin": 9.0,
      "texte": "Enfin, je peux enlever ce déguisement de muscles !"
    },
    {
      "debut": 9.0,
      "fin": 13.08,
      "texte": "Il faut que je trouve un moyen pour que Fraze redevienne squelette !"
    },
    {
      "debut": 13.08,
      "fin": 14.52,
      "texte": "Personne ne doit savoir mon secret."
    },
    {
      "debut": 15.34,
      "fin": 16.06,
      "texte": "Kiwi ?"
    },
    {
      "debut": 16.06,
      "fin": 17.8,
      "texte": "Mais non, c'est pas possible, c'est bien toi !"
    },
    {
      "debut": 17.8,
      "fin": 19.2,
      "texte": "Qu'est-ce que tu fous ici ?"
    },
    {
      "debut": 20.8,
      "fin": 24.08,
      "texte": "Ne me dis pas que c'est pour ça que tu voulais que je reste un squelette ?"
    },
    {
      "debut": 24.08,
      "fin": 26.24,
      "texte": "T'as pas intérêt de répéter ce que tu viens de voir à quelqu'un ?"
    },
    {
      "debut": 26.24,
      "fin": 27.82,
      "texte": "Et dégage d'ici, tu paies rien pour attendre !"
    },
    {
      "debut": 27.82,
      "fin": 29.36,
      "texte": "Ne t'inquiète pas, je n'en parlerai à personne."
    },
    {
      "debut": 32.19,
      "fin": 35.69,
      "texte": "Maintenant, il faut que je trouve un moyen pour qu'elle se taise à jamais."
    },
    {
      "debut": 36.09,
      "fin": 38.91,
      "texte": "Écoutez les mecs, il n'y a personne qui s'approche de Fraze !"
    },
    {
      "debut": 38.91,
      "fin": 39.81,
      "texte": "C'est ma meuf !"
    },
    {
      "debut": 39.81,
      "fin": 40.99,
      "texte": "C'est moi qui mange ça !"
    },
    {
      "debut": 40.99,
      "fin": 43.27,
      "texte": "Vous restez à l'écart sinon vous aurez affaire à moi !"
    },
    {
      "debut": 43.27,
      "fin": 44.19,
      "texte": "Oui, t'inquiète gros !"
    },
    {
      "debut": 45.53,
      "fin": 46.65,
      "texte": "J'arrive pas à y croire."
    },
    {
      "debut": 46.79,
      "fin": 48.77,
      "texte": "Kiwi cachait un si grand secret pendant tout ce temps."
    },
    {
      "debut": 48.89,
      "fin": 50.89,
      "texte": "Pourquoi n'a-t-il jamais assumé son vrai corps ?"
    },
    {
      "debut": 51.51,
      "fin": 52.39,
      "texte": "Je vais aller Gzelle."
    },
    {
      "debut": 52.55,
      "fin": 54.39,
      "texte": "Je suis désolé, je suis obligé d'employer les grands moyens."
    },
    {
      "debut": 54.73,
      "fin": 56.85,
      "texte": "Si jamais les gens découvrent que je suis moi-même un squelette,"
    },
    {
      "debut": 56.99,
      "fin": 59.89,
      "texte": "ils vont tous se moquer de moi et c'est hors de question !"
    },
    {
      "debut": 59.89,
      "fin": 62.73,
      "texte": "Kiwi, qu'est-ce qu'il fait à cette heure chez moi ?"
    }
  ],
