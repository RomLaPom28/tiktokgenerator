{
  "langue": "fr",
  "origine": "sous-titres incrustés lus image par image (pas de whisper)",
  "phrases": [
    {
      "debut": 0.4,
      "fin": 4.4,
      "texte": "Le jour de paye est arrivé. Rassemblez-vous pour recevoir vos salaires."
    },
    {
      "debut": 5.5,
      "fin": 9.0,
      "texte": "Le patron a dû se tromper. Il y a trop d'argent."
    },
    {
      "debut": 10.1,
      "fin": 13.7,
      "texte": "Je devrais lui rendre. Mais ma famille a faim et ma maison tombe en ruine."
    },
    {
      "debut": 14.0,
      "fin": 17.2,
      "texte": "Chérie, j'ai laissé trop d'argent exprès dans le salaire d'un ouvrier."
    },
    {
      "debut": 17.3,
      "fin": 23.6,
      "texte": "S'il revient le rendre, je changerai sa vie et je le nommerai directeur."
    },
    {
      "debut": 24.5,
      "fin": 27.2,
      "texte": "Tu rêves. Vu leur misère, il va garder chaque centime."
    },
    {
      "debut": 27.6,
      "fin": 30.3,
      "texte": "Madame, le patron m'a donné trop d'argent. Je viens le rendre."
    },
    {
      "debut": 30.4,
      "fin": 31.8,
      "texte": "Donne-le-moi. Je vais lui remettre."
    },
    {
      "debut": 32.2,
      "fin": 33.9,
      "texte": "Ne t'inquiète pas, je lui dirai que c'est toi."
    },
    {
      "debut": 34.5,
      "fin": 35.8,
      "texte": "Cet argent est pour moi."
    },
    {
      "debut": 36.2,
      "fin": 38.2,
      "texte": "Je dirai qu'il n'a rien rendu du tout."
    },
    {
      "debut": 42.4,
      "fin": 44.2,
      "texte": "Alors, quelqu'un est venu ?"
    },
    {
      "debut": 44.7,
      "fin": 46.5,
      "texte": "Non mon chéri, personne n'est venu."
    },
    {
      "debut": 47.0,
      "fin": 49.3,
      "texte": "Rends-moi ce que tu me dois et disparais de ma mine."
    },
    {
      "debut": 49.7,
      "fin": 50.9,
      "texte": "Je ne veux pas de voleur ici."
    },
    {
      "debut": 51.2,
      "fin": 53.8,
      "texte": "Mais je ne suis pas un voleur ! S'il te plaît, laisse-moi t'expliquer."
    },
    {
      "debut": 54.3,
      "fin": 55.6,
      "texte": "Assez de mensonges. Dehors !"
    },
    {
      "debut": 56.1,
      "fin": 58.2,
      "texte": "Mais patron, j'ai tout rendu à votre femme."
    },
    {
      "debut": 58.7,
      "fin": 60.3,
      "texte": "Regardez ça. Elle vous ment."
    }
  ],
