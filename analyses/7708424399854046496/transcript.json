{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 2.0,
      "texte": "Mes trois ex m'aimaient pour mes cheveux."
    },
    {
      "debut": 2.26,
      "fin": 3.84,
      "texte": "Lucas, lui, m'aime chauve depuis six mois."
    },
    {
      "debut": 4.8,
      "fin": 5.9,
      "texte": "Ce soir, je rencontre sa famille."
    },
    {
      "debut": 6.42,
      "fin": 7.46,
      "texte": "On va voir qui m'aime vraiment."
    },
    {
      "debut": 7.92,
      "fin": 9.76,
      "texte": "Et si ta famille me trouve moche ?"
    },
    {
      "debut": 9.76,
      "fin": 12.44,
      "texte": "T'es la plus belle, avec ou sans cheveux."
    },
    {
      "debut": 12.6,
      "fin": 13.8,
      "texte": "Lucas, c'est une blague !"
    },
    {
      "debut": 13.8,
      "fin": 15.04,
      "texte": "Elle a pas un seul cheveu !"
    },
    {
      "debut": 15.04,
      "fin": 16.92,
      "texte": "Maman, je te présente Jade. Sois gentille."
    },
    {
      "debut": 17.2,
      "fin": 19.06,
      "texte": "On dirait Zidane en robe de soirée !"
    },
    {
      "debut": 19.06,
      "fin": 20.84,
      "texte": "Une vraie femme, ça a des cheveux."
    },
    {
      "debut": 21.04,
      "fin": 22.82,
      "texte": "Encore un mot sur Jade, et on s'en va."
    },
    {
      "debut": 23.02,
      "fin": 24.6,
      "texte": "Laisse, Lucas, ça ne me dérange pas."
    },
    {
      "debut": 24.92,
      "fin": 27.4,
      "texte": "Mon fils mérite une vraie femme, pas une boule de billard."
    },
    {
      "debut": 27.4,
      "fin": 29.44,
      "texte": "Je te donne 5000 euros pour disparaître."
    },
    {
      "debut": 30.1,
      "fin": 32.18,
      "texte": "Gardez votre argent, madame. Vous en aurez besoin."
    },
    {
      "debut": 32.6,
      "fin": 34.86,
      "texte": "Qu'est-ce qu'elle t'a dit, ma mère ? Dans la cuisine ?"
    },
    {
      "debut": 34.86,
      "fin": 36.54,
      "texte": "Rien. Elle voulait juste faire connaissance."
    },
    {
      "debut": 36.8,
      "fin": 37.24,
      "texte": "Je la connais."
    },
    {
      "debut": 37.94,
      "fin": 39.9,
      "texte": "Si elle te fait du mal, c'est toi que je choisis."
    },
    {
      "debut": 40.4,
      "fin": 42.62,
      "texte": "Clara, ma chérie, ça me dit, c'est l'anniversaire de Lucas."
    },
    {
      "debut": 42.84,
      "fin": 44.46,
      "texte": "Et tu veux que je fasse quoi ?"
    },
    {
      "debut": 44.46,
      "fin": 45.74,
      "texte": "Tu l'embrasses devant la chauve,"
    },
    {
      "debut": 45.94,
      "fin": 48.12,
      "texte": "et elle partira toute seule en pleurant !"
    },
    {
      "debut": 48.12,
      "fin": 49.9,
      "texte": "Joyeux anniversaire, mon beau Lucas !"
    },
    {
      "debut": 49.9,
      "fin": 52.1,
      "texte": "Clara, arrête ! C'est Jade que j'aime."
    },
    {
      "debut": 52.34,
      "fin": 53.44,
      "texte": "Elle ?"
    },
    {
      "debut": 53.44,
      "fin": 55.82,
      "texte": "Mais regarde-la ! Elle a même pas de cheveux !"
    },
    {
      "debut": 55.82,
      "fin": 58.4,
      "texte": "Regardez-la tous ! Vous voulez vraiment d'une femme sans un cheveu ?"
    },
    {
      "debut": 58.4,
      "fin": 60.3,
      "texte": "Une boule de billard au mariage ? Jamais !"
    },
    {
      "debut": 60.3,
      "fin": 61.82,
      "texte": "Vous voulez voir mes cheveux, madame ?"
    },
    {
      "debut": 62.4,
      "fin": 62.94,
      "texte": "Regardez bien."
    }
  ],
