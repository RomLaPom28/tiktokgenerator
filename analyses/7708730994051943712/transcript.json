{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 4.54,
      "texte": "Vous voulez voir mes cheveux, madame ? Alors regardez bien, ça fait 6 mois que je porte ce faux crâne en silicone."
    },
    {
      "debut": 4.88,
      "fin": 7.62,
      "texte": "Je voulais savoir qui m'aimerait vraiment, même sans un seul cheveu."
    },
    {
      "debut": 7.68,
      "fin": 9.82,
      "texte": "Et ce soir, dans cette famille, vous avez tous perdu, madame."
    },
    {
      "debut": 10.32,
      "fin": 13.36,
      "texte": "Jade, 6 mois avec un faux crâne, pourquoi tu m'as jamais rien dit ? A moi ?"
    },
    {
      "debut": 13.36,
      "fin": 17.4,
      "texte": "Mes 3 ex aimaient seulement mes cheveux. Toi tu m'as aimé 100. Je devais en être sûre, Luca."
    },
    {
      "debut": 17.74,
      "fin": 19.82,
      "texte": "Avec ou sans cheveux, Jade, je te choisirais toujours, toi."
    },
    {
      "debut": 20.34,
      "fin": 23.62,
      "texte": "Jade, ma chérie, moi je l'ai toujours dit, quelle femme magnifique, et quel cheveu superbe."
    },
    {
      "debut": 23.82,
      "fin": 26.38,
      "texte": "Maman, il y a 5 minutes, tu l'appelais Zidane en robe de soirée."
    },
    {
      "debut": 26.38,
      "fin": 28.72,
      "texte": "Tout à l'heure, une boule de billard, et maintenant, magnifique ?"
    },
    {
      "debut": 28.72,
      "fin": 30.24,
      "texte": "Vous changez vite d'avis, madame."
    },
    {
      "debut": 30.36,
      "fin": 33.76,
      "texte": "Des cheveux, j'en ai aussi, ma pauvre Jade. Et lundi, je deviens les gérie de Maison Eben."
    },
    {
      "debut": 34.06,
      "fin": 37.68,
      "texte": "Maison Eben, tu es bien sûr de ton casting, Clara. Evidemment, regarde, c'est la fille de leur pub."
    },
    {
      "debut": 37.86,
      "fin": 39.34,
      "texte": "Attends, mais c'est toi, là ?"
    },
    {
      "debut": 39.34,
      "fin": 40.9,
      "texte": "Maison Eben, c'est moi qui l'ai créé, Clara."
    },
    {
      "debut": 41.48,
      "fin": 43.14,
      "texte": "Et ton casting de lundi, c'est moi qui le fais."
    },
    {
      "debut": 43.56,
      "fin": 45.12,
      "texte": "Viens, mais cette année, on cherche une chauve."
    },
    {
      "debut": 45.38,
      "fin": 48.14,
      "texte": "Jade, ma petite Jade chérie, la patronne de Maison Eben."
    },
    {
      "debut": 48.36,
      "fin": 50.36,
      "texte": "Les 5000 euros de l'autre soir, on oublie, d'accord ?"
    },
    {
      "debut": 50.36,
      "fin": 52.7,
      "texte": "Gardez-les bien, madame, je vous l'avais dit, vous en aurez besoin."
    },
    {
      "debut": 53.08,
      "fin": 55.06,
      "texte": "Moi, 5000 euros, je les gagne en une seule heure."
    },
    {
      "debut": 55.48,
      "fin": 58.4,
      "texte": "Jade, attends-moi ! Tu pars sans moi le soir de mon anniversaire, toi ?"
    },
    {
      "debut": 58.4,
      "fin": 61.04,
      "texte": "Allez, monte vite, Lucas. Ton vrai cadeau d'anniversaire, c'est maintenant qu'il commence."
    },
    {
      "debut": 61.44,
      "fin": 63.64,
      "texte": "Ma mère crie partout que t'es la patronne de Maison Eben."
    },
    {
      "debut": 64.06,
      "fin": 66.32,
      "texte": "Et moi qui t'offrais des fleurs du marché tous les samedis ?"
    },
    {
      "debut": 66.32,
      "fin": 67.92,
      "texte": "C'est justement pour ça que je t'aime, Lucas."
    },
    {
      "debut": 68.28,
      "fin": 70.96,
      "texte": "Mais il me reste un dernier test, et celui-là, il est pour ta mère."
    }
  ],
