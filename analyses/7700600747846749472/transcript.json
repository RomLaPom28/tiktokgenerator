{
  "langue": "fr",
  "phrases": [
    {
      "debut": 6.09,
      "fin": 12.13,
      "texte": "Hey, le nouveau ! T'es assis à ma place là, tu sais pas comment ça marche ici ?"
    },
    {
      "debut": 12.13,
      "fin": 14.49,
      "texte": "Ah bon ? J'ai pas vu ton nom écrit sur la chaise."
    },
    {
      "debut": 15.75,
      "fin": 19.45,
      "texte": "Attends, il vient vraiment de répondre à Dylan ?"
    },
    {
      "debut": 19.45,
      "fin": 21.73,
      "texte": "Ce nouveau va pas survivre à sa première journée."
    },
    {
      "debut": 23.63,
      "fin": 27.27,
      "texte": "Écoute-moi bien petit, ici c'est moi qui décide qui mange et où."
    },
    {
      "debut": 30.99,
      "fin": 33.83,
      "texte": "T'as besoin de trois gaz pour faire peur à quelqu'un qui mange ? C'est triste."
    },
    {
      "debut": 37.32,
      "fin": 39.14,
      "texte": "Tu vas regretterie d'avoir ouvert ta bouche."
    },
    {
      "debut": 45.97,
      "fin": 48.73,
      "texte": "C'est tout ? Je pensais que t'étais le plus fort du lier."
    },
    {
      "debut": 52.04,
      "fin": 53.54,
      "texte": "Personne n'a jamais arrêté Dylan comme ça."
    },
    {
      "debut": 53.84,
      "fin": 54.78,
      "texte": "Mais comment il a fait ça ?"
    },
    {
      "debut": 54.78,
      "fin": 56.7,
      "texte": "J'ai quoi pour il a fait ça ?"
    },
    {
      "debut": 60.06,
      "fin": 63.02,
      "texte": "T'as de la chance que les surveillants sont là, sinon je t'aurais déjà détruit."
    },
    {
      "debut": 65.89,
      "fin": 68.47,
      "texte": "La prochaine fois, essaye avec l'autre main, peut-être qu'elle est plus forte."
    },
    {
      "debut": 71.2,
      "fin": 73.84,
      "texte": "Ce petit m'a affouché devant tout le lierre, il croit que c'est terminé ?"
    },
    {
      "debut": 73.84,
      "fin": 74.92,
      "texte": "On fait quoi chef ?"
    },
    {
      "debut": 74.92,
      "fin": 77.76,
      "texte": "À la sortie des cousses vous le suyez, je veux savoir qui il est vraiment."
    }
  ],
