{
  "langue": "fr",
  "phrases": [
    {
      "debut": 1.07,
      "fin": 7.29,
      "texte": "Il est où mon petit frère? C'est plus moi qu'il est, c'est le pharaon. Si tu le cherches t'es mort."
    },
    {
      "debut": 12.66,
      "fin": 16.74,
      "texte": "Ils l'ont laissé devant la porte, c'est sa basket Ilyes, la basket de ton frère."
    },
    {
      "debut": 25.92,
      "fin": 30.28,
      "texte": "Ramène-moi mon fils, je t'en supplie Ilyes, ramène-le-moi."
    },
    {
      "debut": 31.36,
      "fin": 38.18,
      "texte": "Je te le ramène maman, je te le jure. Tu vas pas y aller seul,"
    },
    {
      "debut": 39.12,
      "fin": 43.26,
      "texte": "petit. Il a dit seul coach."
    },
    {
      "debut": 44.46,
      "fin": 47.74,
      "texte": "Il a dit seul, il a pas dit sans entraîneur."
    },
    {
      "debut": 51.94,
      "fin": 72.19,
      "texte": "Toi tu montes, le vieux il reste en bas, le vieux il monte aussi, enfin le petit champion."
    },
    {
      "debut": 73.75,
      "fin": 76.69,
      "texte": "Coco, tu lui as toujours pas dit qui je suis?"
    }
  ],
