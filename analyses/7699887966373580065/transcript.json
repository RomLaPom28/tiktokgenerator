{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 4.26,
      "texte": "Maman, il y a un monsieur déguisé devant la porte, il a plein de ballons et il veut me donner des bonbons."
    },
    {
      "debut": 4.4,
      "fin": 5.76,
      "texte": "Mais son sourire est un peu bizarre."
    },
    {
      "debut": 6.5,
      "fin": 9.32,
      "texte": "Tu sais ma petite, je vais rester là jusqu'à ce que tu m'ouvres."
    },
    {
      "debut": 9.48,
      "fin": 11.74,
      "texte": "Je veux simplement te faire un cadeau."
    },
    {
      "debut": 12.0,
      "fin": 15.18,
      "texte": "Écoute-moi bien ma fille, tu n'ouvres surtout pas cette porte, d'accord ?"
    },
    {
      "debut": 15.18,
      "fin": 17.7,
      "texte": "Même s'il te promet des cadeaux, garde ton téléphone avec toi."
    },
    {
      "debut": 17.9,
      "fin": 19.68,
      "texte": "Je pars maintenant, je serai là dans 10 minutes."
    },
    {
      "debut": 20.14,
      "fin": 23.56,
      "texte": "Mais maman, il dit que c'est gratuit, il veut juste me donner son sac."
    },
    {
      "debut": 24.24,
      "fin": 27.42,
      "texte": "Exactement ma puce, je te donne les bonbons et je m'en vais."
    },
    {
      "debut": 27.42,
      "fin": 28.64,
      "texte": "Allo, la police ?"
    },
    {
      "debut": 28.64,
      "fin": 30.4,
      "texte": "Il y a un homme déguisé en clown devant chez moi."
    },
    {
      "debut": 30.66,
      "fin": 32.52,
      "texte": "Il a un masque horrible, des ballons, des bonbons."
    },
    {
      "debut": 32.76,
      "fin": 35.72,
      "texte": "Il essaie de faire ouvrir la porte à ma fille, elle n'a que 6 ans."
    },
    {
      "debut": 36.22,
      "fin": 39.68,
      "texte": "Madame, vous êtes la cinquième personne à nous appeler pour cet homme ce soir."
    },
    {
      "debut": 39.96,
      "fin": 42.9,
      "texte": "Il promet des bonbons aux enfants et dès qu'ils ouvrent, il entre chez eux."
    },
    {
      "debut": 43.08,
      "fin": 44.96,
      "texte": "Votre fille ne doit surtout pas ouvrir la porte."
    },
    {
      "debut": 45.38,
      "fin": 47.5,
      "texte": "Je vous en supplie, envoyez quelqu'un tout de suite."
    },
    {
      "debut": 47.86,
      "fin": 49.02,
      "texte": "Je suis encore au travail."
    },
    {
      "debut": 49.42,
      "fin": 51.08,
      "texte": "Même en roulant vite, j'en ai pour 10 minutes."
    },
    {
      "debut": 51.34,
      "fin": 52.68,
      "texte": "Ma fille est toute seule à la maison."
    },
    {
      "debut": 53.66,
      "fin": 57.18,
      "texte": "Ma maman a dit que je ne devais pas vous ouvrir, mais vous pouvez laisser les bonbons devant la porte."
    },
    {
      "debut": 57.18,
      "fin": 59.86,
      "texte": "Bien sûr petite, je pose le sac et je recule."
    },
    {
      "debut": 60.12,
      "fin": 61.7,
      "texte": "Vous promettez que vous n'allez pas rentrer ?"
    },
    {
      "debut": 61.7,
      "fin": 62.88,
      "texte": "Je te le promets."
    },
    {
      "debut": 63.06,
      "fin": 64.86,
      "texte": "Bon, il avait l'air plutôt sympa ce clown."
    },
    {
      "debut": 65.58,
      "fin": 67.05,
      "texte": "Je prends juste le sac et je..."
    }
  ],
