{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 2.28,
      "texte": "Je savais qu'elle me cachait quelque chose."
    },
    {
      "debut": 2.46,
      "fin": 5.8,
      "texte": "Pourvu qu'Anna Nico se doute de rien, s'il découvre ça, je le perds pour toujours."
    },
    {
      "debut": 7.64,
      "fin": 9.0,
      "texte": "Monsieur, ici c'est mon motel."
    },
    {
      "debut": 9.06,
      "fin": 10.86,
      "texte": "La vie privée des clients, c'est sacré."
    },
    {
      "debut": 11.12,
      "fin": 12.14,
      "texte": "Personne n'approche des chambres."
    },
    {
      "debut": 12.24,
      "fin": 14.24,
      "texte": "Mais c'est ma femme. Je dois savoir avec qui elle est."
    },
    {
      "debut": 14.28,
      "fin": 15.16,
      "texte": "Désolé, je ne peux pas."
    },
    {
      "debut": 15.8,
      "fin": 17.58,
      "texte": "Hé, je vous ai dit de ne pas approcher des chambres."
    },
    {
      "debut": 17.88,
      "fin": 18.96,
      "texte": "Revenez ici tout de suite."
    },
    {
      "debut": 19.3,
      "fin": 22.06,
      "texte": "Je cherche mon mari à vos cadeaux. Je l'ai suivi jusqu'à ce motel."
    },
    {
      "debut": 22.14,
      "fin": 23.12,
      "texte": "Il est où ?"
    },
    {
      "debut": 23.12,
      "fin": 25.0,
      "texte": "Ah madame, ça je ne peux pas vous aider, désolé."
    },
    {
      "debut": 25.6,
      "fin": 27.14,
      "texte": "Toi aussi on t'a trompé."
    },
    {
      "debut": 27.5,
      "fin": 30.0,
      "texte": "Malheureusement, oui. Et vu ta tête, toi aussi."
    },
    {
      "debut": 30.66,
      "fin": 34.18,
      "texte": "Ma femme m'a dit qu'elle allait chercher du pain chaud et elle a fini dans ce motel."
    },
    {
      "debut": 34.52,
      "fin": 37.26,
      "texte": "Le mien a dit qu'il allait ouvrir l'épicerie. Il est jamais revenu."
    },
    {
      "debut": 38.0,
      "fin": 40.74,
      "texte": "Pardon de m'en mêler, mais pendant que vous souffrez ici, c'est de l'assez classe."
    },
    {
      "debut": 40.82,
      "fin": 43.06,
      "texte": "Vous devez leur donner une leçon. Vous n'avez qu'à faire pareil qu'eux."
    },
    {
      "debut": 43.08,
      "fin": 46.3,
      "texte": "Je ne suis pas sûr. Je ne sais pas, j'aime encore Orange là."
    },
    {
      "debut": 46.82,
      "fin": 50.18,
      "texte": "Et moi, mon mari, mais on ne peut pas les laisser s'en tirer comme ça."
    },
    {
      "debut": 53.08,
      "fin": 55.66,
      "texte": "Je vous offre une chambre. C'est la maison qui régale."
    },
    {
      "debut": 56.26,
      "fin": 58.82,
      "texte": "Maintenant, c'est à eux de sentir ce qu'on a ressenti."
    },
    {
      "debut": 58.82,
      "fin": 61.16,
      "texte": "C'est notre vengeance. Tu veux la suite ?"
    },
    {
      "debut": 61.16,
      "fin": 61.96,
      "texte": "Commente partie 3."
    }
  ],
