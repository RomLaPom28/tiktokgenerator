{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 2.26,
      "texte": "Wesh, des lunettes par terre !"
    },
    {
      "debut": 2.26,
      "fin": 4.52,
      "texte": "Attends, il m'arrive quoi ? Je suis invisible ou je rêve là ?"
    },
    {
      "debut": 4.52,
      "fin": 6.14,
      "texte": "C'est une dinguerie ça wesh !"
    },
    {
      "debut": 6.14,
      "fin": 9.34,
      "texte": "C'est les lunettes qui régale aujourd'hui, je veux le repas le plus cher de ce restaurant monsieur !"
    },
    {
      "debut": 9.34,
      "fin": 11.44,
      "texte": "Vous êtes sûr de vous ? Ça va vous coûter très cher."
    },
    {
      "debut": 11.58,
      "fin": 15.04,
      "texte": "T'inquiète j'ai trop la dalle, ramène moi ce que je veux maintenant s'te plaît merci !"
    },
    {
      "debut": 15.04,
      "fin": 15.66,
      "texte": "Ok monsieur."
    },
    {
      "debut": 16.16,
      "fin": 17.96,
      "texte": "Alors ça arrive ou quoi mon ventre gargouille ?"
    },
    {
      "debut": 17.96,
      "fin": 20.52,
      "texte": "Le cuistot sans charge, voulez-vous autre chose en attendant ?"
    },
    {
      "debut": 20.52,
      "fin": 21.86,
      "texte": "Non pas pour l'instant merci."
    },
    {
      "debut": 22.68,
      "fin": 27.84,
      "texte": "C'est parti je vais me régaler !"
    },
    {
      "debut": 27.84,
      "fin": 30.16,
      "texte": "Oh je suis bien calé là Théma mon ventre il en peut plus."
    },
    {
      "debut": 30.34,
      "fin": 31.68,
      "texte": "Tout s'est bien passé monsieur ?"
    },
    {
      "debut": 31.68,
      "fin": 33.98,
      "texte": "Faitement bien, vous devez payer 3000 euros maintenant."
    },
    {
      "debut": 34.22,
      "fin": 35.48,
      "texte": "Ok pas de soucis."
    },
    {
      "debut": 36.44,
      "fin": 39.42,
      "texte": "Avant de payer j'ai une petite envie pressante, où sont vos toilettes ?"
    },
    {
      "debut": 39.42,
      "fin": 40.7,
      "texte": "Au fond du couloir à gauche monsieur."
    },
    {
      "debut": 41.0,
      "fin": 42.2,
      "texte": "Ok merci je reviens après."
    },
    {
      "debut": 44.34,
      "fin": 46.38,
      "texte": "Je sais pas mais j'ai un mauvais pressentiment avec ce mec."
    },
    {
      "debut": 46.48,
      "fin": 49.04,
      "texte": "Je vais le garder à l'œil, j'ai pas envie de me faire virer à cause de lui."
    },
    {
      "debut": 50.4,
      "fin": 52.2,
      "texte": "Il met sa vie dans les chiottes ses chevaux ça !"
    },
    {
      "debut": 52.2,
      "fin": 55.4,
      "texte": "Soit il a trop mangé et il est en train de tout évacuer, soit il veut me la faire à l'envers."
    },
    {
      "debut": 56.36,
      "fin": 58.36,
      "texte": "Il croit vraiment que je vais payer 3000 balles sérieux ?"
    },
    {
      "debut": 58.36,
      "fin": 60.9,
      "texte": "Avec mes lunettes il risque de plus me revoir le pauvre mais ça il le sait pas encore."
    },
    {
      "debut": 61.68,
      "fin": 62.32,
      "texte": "Tchao !"
    }
  ],
