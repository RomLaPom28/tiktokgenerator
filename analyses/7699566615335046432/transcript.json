{
  "langue": "fr",
  "phrases": [
    {
      "debut": 1.42,
      "fin": 3.48,
      "texte": "Ah, non, mon dernier bras !"
    },
    {
      "debut": 4.9,
      "fin": 6.7,
      "texte": "Voilà, c'est fini !"
    },
    {
      "debut": 6.7,
      "fin": 7.92,
      "texte": "Tu m'avais déjà dit ça !"
    },
    {
      "debut": 8.84,
      "fin": 11.38,
      "texte": "Brownie, cake, je peux tout faire !"
    },
    {
      "debut": 11.38,
      "fin": 13.42,
      "texte": "Citronelle, regarde-moi !"
    },
    {
      "debut": 13.42,
      "fin": 15.86,
      "texte": "Attends, tu vois pas que je travaille dans même ?"
    },
    {
      "debut": 17.98,
      "fin": 19.76,
      "texte": "Boutique pour être ensemble !"
    },
    {
      "debut": 19.76,
      "fin": 21.58,
      "texte": "On est ensemble, je suis juste à côté !"
    },
    {
      "debut": 22.2,
      "fin": 23.94,
      "texte": "Tu vas me laisser là combien de temps ?"
    },
    {
      "debut": 23.94,
      "fin": 25.3,
      "texte": "Je sais pas, tant que ça..."
    },
    {
      "debut": 25.3,
      "fin": 27.14,
      "texte": "Votre mari, on le voit plus, m'en !"
    },
    {
      "debut": 27.14,
      "fin": 29.34,
      "texte": "Il travaille en cuisine !"
    },
    {
      "debut": 29.34,
      "fin": 31.68,
      "texte": "Félicitez-le, c'est une tuerie !"
    },
    {
      "debut": 31.68,
      "fin": 33.66,
      "texte": "Bonjour, ma femme voudrait un dessert pour ce soir."
    },
    {
      "debut": 33.9,
      "fin": 35.68,
      "texte": "Bien sûr ! Vous aimez le chocolat blanc, t'as ?"
    },
    {
      "debut": 36.36,
      "fin": 37.74,
      "texte": "Vous avez une peau incroyable !"
    },
    {
      "debut": 38.66,
      "fin": 39.98,
      "texte": "Doucement, je suis marié !"
    },
    {
      "debut": 39.98,
      "fin": 41.88,
      "texte": "Moi aussi, ça nous fait un point commun !"
    },
    {
      "debut": 41.88,
      "fin": 43.88,
      "texte": "Venez goûter ma nouvelle recette, c'est en bas !"
    },
    {
      "debut": 43.88,
      "fin": 45.28,
      "texte": "Juste une minute, la langue elle, maintenant !"
    },
    {
      "debut": 46.02,
      "fin": 46.74,
      "texte": "Promis !"
    },
    {
      "debut": 46.74,
      "fin": 48.16,
      "texte": "C'est quoi ce meur ?"
    },
    {
      "debut": 48.16,
      "fin": 49.22,
      "texte": "Monsieur, vous m'entendez pas ?"
    },
    {
      "debut": 49.86,
      "fin": 51.28,
      "texte": "Va-t'en, t'entends ? Maintenant !"
    },
    {
      "debut": 52.38,
      "fin": 53.68,
      "texte": "Il exagère toujours !"
    },
    {
      "debut": 54.46,
      "fin": 56.06,
      "texte": "Ça brûle ! Lâchez-moi !"
    },
    {
      "debut": 56.06,
      "fin": 57.1,
      "texte": "Bouge pas !"
    },
    {
      "debut": 57.1,
      "fin": 58.22,
      "texte": "Mais je peux plus bouger !"
    },
    {
      "debut": 59.9,
      "fin": 62.76,
      "texte": "C'est ma femme ! Répondez, s'il vous plaît !"
    },
    {
      "debut": 63.52,
      "fin": 63.92,
      "texte": "Après."
    },
    {
      "debut": 64.78,
      "fin": 65.64,
      "texte": "Elle me disait ça aussi."
    },
    {
      "debut": 67.14,
      "fin": 68.98,
      "texte": "Mon mari est venu ici, il répond plus."
    },
    {
      "debut": 70.26,
      "fin": 71.56,
      "texte": "Chocolat blanc, donnant ?"
    },
    {
      "debut": 71.56,
      "fin": 72.22,
      "texte": "Oui, je l'ai vu."
    },
    {
      "debut": 72.58,
      "fin": 73.06,
      "texte": "Asseyez-vous."
    },
    {
      "debut": 74.42,
      "fin": 76.72,
      "texte": "Chocolat blanc, chocolat au lait, goûtez, c'est offert."
    },
    {
      "debut": 76.96,
      "fin": 78.48,
      "texte": "Merci, mais il est où, la blanc ?"
    },
    {
      "debut": 78.48,
      "fin": 79.26,
      "texte": "Il est reparti."
    },
    {
      "debut": 80.7,
      "fin": 83.32,
      "texte": "Cet odeur, c'est le même parfum que lui !"
    },
    {
      "debut": 83.32,
      "fin": 84.3,
      "texte": "C'est du chocolat, madame."
    },
    {
      "debut": 84.68,
      "fin": 85.48,
      "texte": "Oui, bien sûr."
    },
    {
      "debut": 85.86,
      "fin": 87.28,
      "texte": "Je peux aller aux toilettes ?"
    },
    {
      "debut": 87.28,
      "fin": 88.02,
      "texte": "Au fond, à droite."
    },
    {
      "debut": 91.62,
      "fin": 93.42,
      "texte": "Elle est derrière toi !"
    },
    {
      "debut": 93.42,
      "fin": 97.18,
      "texte": "Approche pas !"
    },
    {
      "debut": 97.18,
      "fin": 99.16,
      "texte": "Je crois que je vais rajouter du caramel à ma collection."
    }
