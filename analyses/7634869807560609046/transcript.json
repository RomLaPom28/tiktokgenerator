{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 4.54,
      "texte": "J'ai tout entendu. Une framboise, t'es une framboise, et le bébé c'est le tien."
    },
    {
      "debut": 4.98,
      "fin": 6.66,
      "texte": "Attends, ce n'est pas ce que tu crois !"
    },
    {
      "debut": 6.66,
      "fin": 7.52,
      "texte": "Je peux m'expliquer."
    },
    {
      "debut": 7.86,
      "fin": 9.1,
      "texte": "Combien ils ont signé ?"
    },
    {
      "debut": 9.1,
      "fin": 9.88,
      "texte": "Quoi ?"
    },
    {
      "debut": 9.88,
      "fin": 11.62,
      "texte": "Mes parents, combien ils ont signé ?"
    },
    {
      "debut": 11.62,
      "fin": 13.38,
      "texte": "L'entreprise est 50% à vie."
    },
    {
      "debut": 13.96,
      "fin": 14.54,
      "texte": "C'est tout ?"
    },
    {
      "debut": 14.54,
      "fin": 15.96,
      "texte": "Tu vas me dénoncer ?"
    },
    {
      "debut": 15.96,
      "fin": 17.6,
      "texte": "Te dénoncer, pour quoi faire ?"
    },
    {
      "debut": 17.6,
      "fin": 19.34,
      "texte": "J'ai une bien meilleure idée et tu vas m'aider."
    },
    {
      "debut": 19.48,
      "fin": 22.66,
      "texte": "Il faut d'abord que t'ailles faire semblant de t'excuser et de tout avouer."
    },
    {
      "debut": 22.8,
      "fin": 23.92,
      "texte": "C'est l'étape 1 du plan."
    },
    {
      "debut": 24.06,
      "fin": 26.76,
      "texte": "Je voulais m'excuser et vous dire qu'en vérité je suis une framboise."
    },
    {
      "debut": 26.92,
      "fin": 29.22,
      "texte": "Je n'avais pas conscience de mes actes, je suis vraiment désolé."
    },
    {
      "debut": 29.22,
      "fin": 30.92,
      "texte": "Quoi ? Traite, tu n'auras rien !"
    },
    {
      "debut": 30.92,
      "fin": 32.24,
      "texte": "Je suis tellement déçue."
    },
    {
      "debut": 32.4,
      "fin": 34.96,
      "texte": "J'avais déjà réfléchi à une arnaque avant que tu me fasses ton coup,"
    },
    {
      "debut": 35.26,
      "fin": 36.88,
      "texte": "et j'ai repéré un certain Mango."
    },
    {
      "debut": 37.1,
      "fin": 38.42,
      "texte": "Qu'est-ce qu'il vient faire là-dedans lui ?"
    },
    {
      "debut": 38.42,
      "fin": 40.6,
      "texte": "Il est seul et cherche un jeune héritier depuis des années,"
    },
    {
      "debut": 40.72,
      "fin": 41.96,
      "texte": "en échange d'une somme d'argent."
    },
    {
      "debut": 42.12,
      "fin": 44.4,
      "texte": "Mais on va lui prendre bien plus que ça."
    },
    {
      "debut": 44.92,
      "fin": 45.32,
      "texte": "Exactement."
    },
    {
      "debut": 45.48,
      "fin": 46.72,
      "texte": "Il est magnifique."
    },
    {
      "debut": 46.88,
      "fin": 49.82,
      "texte": "Il a besoin d'un protecteur, quelqu'un de puissant comme vous."
    },
    {
      "debut": 50.38,
      "fin": 53.68,
      "texte": "Vous avez bien fait de venir, ça fait des années que je cherche un bel héritier."
    },
    {
      "debut": 53.86,
      "fin": 55.06,
      "texte": "Les papiers sont dans mon bureau."
    },
    {
      "debut": 55.32,
      "fin": 58.7,
      "texte": "Nous allons régler tout ça avec mon notaire qui arrive d'ici 5 minutes."
    },
    {
      "debut": 58.7,
      "fin": 60.78,
      "texte": "Je vais faire un tour aux toilettes, en attendant j'arrive."
    },
    {
      "debut": 60.94,
      "fin": 64.56,
      "texte": "Je remplace le nom du bébé par mon nom, et tous ces biens seront à moi."
    },
    {
      "debut": 65.34,
      "fin": 67.12,
      "texte": "C'est bon, les papiers sont falsifiés."
    },
    {
      "debut": 67.36,
      "fin": 68.24,
      "texte": "On va devenir riches."
    },
    {
      "debut": 68.36,
      "fin": 70.28,
      "texte": "Bien joué, on n'a plus qu'à attendre maintenant."
    },
    {
      "debut": 70.54,
      "fin": 71.54,
      "texte": "Le grand jour est arrivé."
    },
    {
      "debut": 71.86,
      "fin": 73.14,
      "texte": "Je veux tout léguer à l'enfant."
    },
    {
      "debut": 73.34,
      "fin": 74.12,
      "texte": "Rédiger les papiers."
    },
    {
      "debut": 74.32,
      "fin": 76.76,
      "texte": "Vous êtes sûr, après ça plus de retours en arrière possible ?"
    },
    {
      "debut": 76.76,
      "fin": 77.12,
      "texte": "Certain."
    },
    {
      "debut": 77.32,
      "fin": 78.7,
      "texte": "Qu'est-ce que t'es naïf ?"
    },
    {
      "debut": 78.7,
      "fin": 80.8,
      "texte": "J'ai modifié les papiers et j'ai tout mis à mon nom !"
    },
    {
      "debut": 80.8,
      "fin": 81.98,
      "texte": "Quoi ? T'as quand même pas fait ça !"
    },
    {
      "debut": 81.98,
      "fin": 84.86,
      "texte": "Tu ne pensais pas qu'après ce que tu m'as fait, je te laisserais quelque chose ?"
    },
    {
      "debut": 84.86,
      "fin": 86.58,
      "texte": "Tu ne peux plus revenir en arrière maintenant."
    },
    {
      "debut": 86.58,
      "fin": 89.06,
      "texte": "Je connais un moyen de nous venger."
    },
    {
      "debut": 90.06,
      "fin": 91.72,
      "texte": "Maintenant on va parler, toi et moi."
    }
  ],
