{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 2.56,
      "texte": "À partir d'aujourd'hui, tu vas devoir courir avec ça."
    },
    {
      "debut": 2.66,
      "fin": 4.3,
      "texte": "Mais papa, c'est quoi ces chaussures ?"
    },
    {
      "debut": 4.3,
      "fin": 6.46,
      "texte": "Ce sont des chaussures de renforcement, elles pèsent 100 kilos."
    },
    {
      "debut": 6.92,
      "fin": 8.84,
      "texte": "Et tu n'as pas le droit de les enlever avant tes 18 ans."
    },
    {
      "debut": 10.18,
      "fin": 12.42,
      "texte": "Papa, j'y arrive pas, c'est beaucoup trop lourd !"
    },
    {
      "debut": 12.42,
      "fin": 15.76,
      "texte": "Arrête de pleurnicher, Léo ! Ton corps doit apprendre à supporter le poids !"
    },
    {
      "debut": 15.76,
      "fin": 18.66,
      "texte": "Mais papa, j'arrive même pas à mettre un pied devant l'autre !"
    },
    {
      "debut": 18.66,
      "fin": 21.64,
      "texte": "Bonjour, je voudrais inscrire mon fils dans le groupe des 8 ans."
    },
    {
      "debut": 22.08,
      "fin": 25.44,
      "texte": "Ha ha ha ! Vous vous moquez de moi ? Regardez la paire de savates qu'il a au pied !"
    },
    {
      "debut": 26.38,
      "fin": 29.32,
      "texte": "Non, ce n'est pas une blague. Il court à bec et il a interdiction de les enlever."
    },
    {
      "debut": 29.32,
      "fin": 32.52,
      "texte": "Hé, Citron ! Tu feras gaffe, t'es déjà dans le rétro !"
    },
    {
      "debut": 32.52,
      "fin": 35.8,
      "texte": "C'est facile à dire ! Toi, tu cours pas avec 100 kilos au pied !"
    },
    {
      "debut": 35.8,
      "fin": 39.04,
      "texte": "Tu ferais mieux d'abandonner maintenant, c'est vraiment pas un sport fait pour toi !"
    },
    {
      "debut": 39.04,
      "fin": 42.36,
      "texte": "Papa, s'il te plaît, tout le monde se fout de moi. Laisse-moi les enlever."
    },
    {
      "debut": 42.56,
      "fin": 44.08,
      "texte": "Non, Léo, pas avant tes 18 ans."
    },
    {
      "debut": 44.26,
      "fin": 45.16,
      "texte": "Mais pourquoi ?"
    },
    {
      "debut": 45.16,
      "fin": 48.18,
      "texte": "Un jour, tu comprendras, je te le promets. Mais pour le moment, il est encore trop tôt."
    },
    {
      "debut": 49.08,
      "fin": 52.32,
      "texte": "10 ans que je cours avec ces chaussures, et j'ai toujours pas abandonné."
    },
    {
      "debut": 52.66,
      "fin": 54.84,
      "texte": "Oui, le championnat approche et tu es presque prêt."
    },
    {
      "debut": 55.08,
      "fin": 56.52,
      "texte": "Ouais, j'ai tellement hâte de les enlever."
    },
    {
      "debut": 57.38,
      "fin": 60.84,
      "texte": "Samedi, c'est les championnats nationaux, et il y aura des recruteurs dans les tribunes."
    },
    {
      "debut": 61.14,
      "fin": 62.98,
      "texte": "Parfait, ça leur fera une occasion de me voir gagner."
    },
    {
      "debut": 63.12,
      "fin": 65.16,
      "texte": "Et toi, tu comptes me ramener la médaille ?"
    },
    {
      "debut": 65.16,
      "fin": 68.02,
      "texte": "Léo, je vais être franc, t'es pas sélectionné pour samedi."
    },
    {
      "debut": 68.4,
      "fin": 69.88,
      "texte": "Quoi ? Mais pourquoi ?"
    },
    {
      "debut": 69.88,
      "fin": 74.1,
      "texte": "Tes chronos sont trop boués, tu ne peux pas représenter le club avec des temps aussi hauts. Désolé."
    },
    {
      "debut": 74.82,
      "fin": 76.96,
      "texte": "Il m'a viré, papa ! Même pas sélectionné !"
    },
    {
      "debut": 76.96,
      "fin": 79.16,
      "texte": "10 ans avec ces putains de chaussures, tout ça pour rien !"
    },
    {
      "debut": 79.16,
      "fin": 81.14,
      "texte": "Regarde-moi, Léo, tu te souviens de ma promesse ?"
    },
    {
      "debut": 81.14,
      "fin": 83.28,
      "texte": "Oui, tu m'avais dit d'attendre mes 18 ans."
    },
    {
      "debut": 83.84,
      "fin": 87.22,
      "texte": "Eh bien, on y est. Enlève ces chaussures et viens avec moi."
    },
    {
      "debut": 87.66,
      "fin": 88.64,
      "texte": "On retourne voir ton coach."
    }
  ],
