  "phrases": [
    {
      "debut": 0.1,
      "fin": 2.3,
      "texte": "Ma femme m'a juré que t'avais gardé l'argent pour toi, Banane."
    },
    {
      "debut": 3.0,
      "fin": 4.6,
      "texte": "Elle m'a dit que t'étais qu'un p'tit voleur."
    },
    {
      "debut": 5.3,
      "fin": 6.6,
      "texte": "Elle vous a bien baladé, patron."
    },
    {
      "debut": 7.3,
      "fin": 8.4,
      "texte": "C'est elle, la vraie michto."
    },
    {
      "debut": 9.1,
      "fin": 11.2,
      "texte": "Regardez mon téléphone. Cette fois-ci, vous allez voir qu'elle vous a menti."
    },
    {
      "debut": 12.2,
      "fin": 13.3,
      "texte": "Cet argent est pour moi."
    },
    {
      "debut": 13.7,
      "fin": 15.4,
      "texte": "Je dirai qu'il n'a rien rendu du tout."
    },
    {
      "debut": 20.0,
      "fin": 22.2,
      "texte": "Elle a cru qu'elle allait m'entuber pour s'acheter des bijoux."
    },
    {
      "debut": 23.1,
      "fin": 25.0,
      "texte": "Cette michto a oublié à qui elle parlait."
    },
    {
      "debut": 25.7,
      "fin": 28.2,
      "texte": "On va lui faire une surprise qu'elle n'oubliera jamais."
    },
    {
      "debut": 28.5,
      "fin": 31.0,
      "texte": "Oui patron. Personne ne ment au patron."
    },
    {
      "debut": 40.6,
      "fin": 42.2,
      "texte": "On ne lui laisse aucune issue."
    },
    {
      "debut": 42.5,
      "fin": 45.1,
      "texte": "Elle doit sentir le froid avant de sentir la douleur."
    },
    {
      "debut": 49.8,
      "fin": 51.0,
      "texte": "Qu'est-ce qui m'arrive ?"
    },
    {
      "debut": 51.9,
      "fin": 53.1,
      "texte": "J'ai le corps qui brûle."
    }
  ],
