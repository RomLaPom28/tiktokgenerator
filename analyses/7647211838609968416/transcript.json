{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.68,
      "fin": 3.58,
      "texte": "Je suis obligé si je veux réussir à séduire mon meilleur ami."
    },
    {
      "debut": 3.86,
      "fin": 6.4,
      "texte": "Tu es tellement belle. Je ne t'ai jamais vu dans le coin avant."
    },
    {
      "debut": 6.5,
      "fin": 8.46,
      "texte": "Tu me rappelles mon meilleur ami, Fraisitigno."
    },
    {
      "debut": 8.82,
      "fin": 10.16,
      "texte": "C'est normal, je suis sa sœur."
    },
    {
      "debut": 10.54,
      "fin": 12.64,
      "texte": "Fraisitigno ne m'a jamais dit qu'il avait une sœur aussi jolie."
    },
    {
      "debut": 12.72,
      "fin": 15.06,
      "texte": "Vous vous ressemblez vraiment. J'aimerais mieux apprendre à te connaître."
    },
    {
      "debut": 15.14,
      "fin": 17.04,
      "texte": "J'en ai très envie aussi, tu sais. Revoyons-nous."
    },
    {
      "debut": 17.1,
      "fin": 19.86,
      "texte": "Dis-moi, Fraisitigno, tu m'avais jamais dit que tu avais une sœur si jolie."
    },
    {
      "debut": 20.0,
      "fin": 21.32,
      "texte": "Mec, je crois que je tombe amoureux d'elle."
    },
    {
      "debut": 21.4,
      "fin": 24.3,
      "texte": "Si tu es ok avec ça, j'aimerais passer plus de temps avec elle."
    },
    {
      "debut": 24.34,
      "fin": 26.68,
      "texte": "C'est ok, mais ne lui brise pas le cœur. Elle est fragile."
    },
    {
      "debut": 27.66,
      "fin": 29.74,
      "texte": "Pourquoi je ne suis pas normal comme ça ?"
    },
    {
      "debut": 29.74,
      "fin": 31.94,
      "texte": "Pourquoi je fais ça à mon meilleur ami ?"
    },
    {
      "debut": 31.94,
      "fin": 34.12,
      "texte": "On ne se connaît pas depuis longtemps, mais c'est bizarre."
    },
    {
      "debut": 34.28,
      "fin": 35.78,
      "texte": "J'ai l'impression de t'avoir toujours connu."
    },
    {
      "debut": 35.92,
      "fin": 38.68,
      "texte": "Non, je comprends ce que tu veux dire. Je ressens exactement la même chose."
    },
    {
      "debut": 39.6,
      "fin": 41.18,
      "texte": "Je sais qu'on ne se connaît pas depuis longtemps,"
    },
    {
      "debut": 41.9,
      "fin": 43.74,
      "texte": "mais je suis tombé fou amoureux de toi."
    },
    {
      "debut": 43.88,
      "fin": 45.18,
      "texte": "Veux-tu m'épouser ?"
    },
    {
      "debut": 45.18,
      "fin": 47.54,
      "texte": "C'est la sœur de Fraisitigno. Je l'ai demandé en mariage."
    },
    {
      "debut": 47.6,
      "fin": 49.24,
      "texte": "Et elle a dit oui. J'ai enfin trouvé la bonne."
    },
    {
      "debut": 49.36,
      "fin": 51.74,
      "texte": "Elle lui ressemble beaucoup. Je suis très heureuse pour vous."
    },
    {
      "debut": 54.14,
      "fin": 57.24,
      "texte": "Donc Fraisitigno est en fait Fraisitigno. Je dois aller le dire à mon frère."
    },
    {
      "debut": 57.24,
      "fin": 59.52,
      "texte": "Mais Fraisitigno n'est toujours pas là, je ne comprends pas."
    },
    {
      "debut": 59.56,
      "fin": 60.48,
      "texte": "Il m'avait dit qu'il viendrait."
    },
    {
      "debut": 60.6,
      "fin": 62.54,
      "texte": "Il est peut-être malade. Je ne peux plus attendre."
    },
    {
      "debut": 62.6,
      "fin": 64.58,
      "texte": "Je veux qu'on se marie maintenant pour enfin être ensemble."
    },
    {
      "debut": 64.88,
      "fin": 67.86,
      "texte": "Je m'oppose à ce mariage. Bananito, je dois te dire quelque chose"
    },
    {
      "debut": 67.86,
      "fin": 69.68,
      "texte": "sur la femme que tu t'apprêtes à épouser."
    }
  ],
