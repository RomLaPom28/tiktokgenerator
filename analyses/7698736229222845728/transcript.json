{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 3.02,
      "texte": "Wesh, c'est qui ce mec que tout le monde a peur, même Ananasito le craint ?"
    },
    {
      "debut": 3.02,
      "fin": 6.02,
      "texte": "Oui, ce gars porte le chiffre 199 sur le front, vaut mieux pas s'approcher de lui, crois-moi."
    },
    {
      "debut": 6.22,
      "fin": 9.74,
      "texte": "Pourquoi t'es là ? Je pensais que tu étais parti dans une autre prison !"
    },
    {
      "debut": 9.74,
      "fin": 14.12,
      "texte": "Je vois que t'as gardé le même chiffre sur le front depuis tout ce temps que je suis parti, incroyable ça !"
    },
    {
      "debut": 14.12,
      "fin": 16.52,
      "texte": "C'est qui ce mec qui porte le chiffre 199 sur son front ?"
    },
    {
      "debut": 16.52,
      "fin": 18.82,
      "texte": "Tout le monde se fait caca-culotte en le voyant wesh !"
    },
    {
      "debut": 18.82,
      "fin": 21.62,
      "texte": "Évite de croiser son regard, si tu veux pas que ton chiffre augmente mon pote."
    },
    {
      "debut": 22.18,
      "fin": 25.38,
      "texte": "T'as encore peur de moi après tout ce temps sérieux ?"
    },
    {
      "debut": 25.38,
      "fin": 28.18,
      "texte": "Fais ton kéké, t'inquiète même pas mon gars, t'es pas prêt !"
    },
    {
      "debut": 28.18,
      "fin": 30.78,
      "texte": "Personne peut découvrir mon vrai chiffre sous mon zéro wesh."
    },
    {
      "debut": 31.06,
      "fin": 32.78,
      "texte": "Y'a que moi qui connais ton vrai chiffre mon gars."
    },
    {
      "debut": 34.22,
      "fin": 36.56,
      "texte": "Frérot, j'ai entendu Myrtilo et Grenadio discuter entre eux."
    },
    {
      "debut": 36.72,
      "fin": 38.76,
      "texte": "Myrtilo le zéro sur son front, c'est pas son vrai chiffre à skip."
    },
    {
      "debut": 39.02,
      "fin": 40.74,
      "texte": "Grenadio seulement lui connaît le vrai chiffre de Myrtilo."
    },
    {
      "debut": 41.14,
      "fin": 43.98,
      "texte": "Te mêle pas de ça frérot, tu vas finir mal mon copain je te jure."
    },
    {
      "debut": 44.42,
      "fin": 46.24,
      "texte": "Tu veux quoi encore de moi mec ?"
    },
    {
      "debut": 46.24,
      "fin": 48.74,
      "texte": "Je veux augmenter ton chiffre, ça fait trop longtemps que c'est le même."
    },
    {
      "debut": 49.2,
      "fin": 51.18,
      "texte": "C'est bon 67 fois, on peut s'arrêter là en vrai ?"
    },
    {
      "debut": 51.18,
      "fin": 54.8,
      "texte": "Non c'est moi qui décide, c'est bon frérot, il est temps de montrer ton vrai chiffre à tout le monde."
    },
    {
      "debut": 55.04,
      "fin": 58.36,
      "texte": "Je t'en supplie, tu sauves pas ça s'te plaît mec !"
    },
    {
      "debut": 58.36,
      "fin": 61.94,
      "texte": "On a vu la même chose, rassure moi frérot, il a 350 en vrai pas zéro wesh !"
    },
    {
      "debut": 61.94,
      "fin": 64.02,
      "texte": "Ouais je m'attendais à tout sauf pas ça wesh, surtout pas lui en fait, ça m'étonne."
    }
  ],
