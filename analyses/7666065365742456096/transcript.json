{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 2.46,
      "texte": "Messi, tu seras mon chouchou et je te donnerai tout ce que tu veux pour réussir."
    },
    {
      "debut": 2.6,
      "fin": 4.6,
      "texte": "Et toi Ronaldo, tu auras rien du tout imbécile !"
    },
    {
      "debut": 4.6,
      "fin": 7.06,
      "texte": "Putain papa, pourquoi moi j'ai pas le droit de manger le homard et le caviar ?"
    },
    {
      "debut": 7.06,
      "fin": 8.2,
      "texte": "Messi, c'est ton chouchou ou quoi ?"
    },
    {
      "debut": 8.2,
      "fin": 10.36,
      "texte": "Ronaldo, arrête de te plaindre tout le temps et ne me parle pas comme ça !"
    },
    {
      "debut": 10.36,
      "fin": 11.78,
      "texte": "Mange ton pain et arrête de casser les couilles !"
    },
    {
      "debut": 11.78,
      "fin": 12.54,
      "texte": "Depuis le début, j'ai un plan."
    },
    {
      "debut": 12.7,
      "fin": 14.36,
      "texte": "Messi va devenir le meilleur joueur de football de tous les temps."
    },
    {
      "debut": 14.4,
      "fin": 15.94,
      "texte": "Je vais payer les arbitres pour qu'il ait que des penalties."
    },
    {
      "debut": 16.1,
      "fin": 17.2,
      "texte": "Et Ronaldo, je vais rien payer du tout."
    },
    {
      "debut": 17.22,
      "fin": 19.08,
      "texte": "Il va sûrement finir chez McDonald's !"
    },
    {
      "debut": 19.08,
      "fin": 20.86,
      "texte": "Tiens Ronaldo, tu veux goûter à ma sucette ?"
    },
    {
      "debut": 20.86,
      "fin": 21.76,
      "texte": "T'es sérieux Messi ?"
    },
    {
      "debut": 21.76,
      "fin": 24.12,
      "texte": "Oui, j'ai trop envie, j'en ai marre de manger des bouts de pain éclatés au sol !"
    },
    {
      "debut": 24.12,
      "fin": 25.96,
      "texte": "Je rigole, fils de pute, va manger du pain !"
    },
    {
      "debut": 25.96,
      "fin": 28.86,
      "texte": "Tiens Messi, prends cet argent et va t'acheter tout ce que tu veux à manger."
    },
    {
      "debut": 29.14,
      "fin": 30.46,
      "texte": "Et tu peux même acheter la PS5."
    },
    {
      "debut": 30.66,
      "fin": 32.48,
      "texte": "Merci papa, mais pourquoi moi j'ai le droit à tout ce que je veux ?"
    },
    {
      "debut": 32.48,
      "fin": 33.6,
      "texte": "Et Ronaldo, c'est un clochard !"
    },
    {
      "debut": 33.6,
      "fin": 37.22,
      "texte": "Tiens Ronaldo, prends ces cailloux et va jouer à Gag de Hors, tu vas bien t'amuser !"
    },
    {
      "debut": 37.22,
      "fin": 38.32,
      "texte": "Mais tu te fous de ma gueule ou quoi papa ?"
    },
    {
      "debut": 38.32,
      "fin": 40.28,
      "texte": "Messi a reçu 15 millions en cash et moi je reçois des cailloux !"
    },
    {
      "debut": 40.28,
      "fin": 41.64,
      "texte": "Je vais te casser le bras si tu continues !"
    },
    {
      "debut": 41.64,
      "fin": 43.32,
      "texte": "Putain mais je vais écouter ce que dit le daron au téléphone."
    },
    {
      "debut": 43.32,
      "fin": 45.74,
      "texte": "Parce que c'est sûr qu'il manigance quelque chose ce fils de pute !"
    },
    {
      "debut": 45.74,
      "fin": 48.72,
      "texte": "Pourquoi moi j'ai que des cailloux et Messi l'a plein d'argent, c'est pas normal !"
    },
    {
      "debut": 48.72,
      "fin": 51.54,
      "texte": "Oui allô mon chéri, il faut que tu inscrives Messi au centre de formation du Barça s'il te plaît,"
    },
    {
      "debut": 51.6,
      "fin": 52.62,
      "texte": "il est prêt à commencer à s'entraîner."
    },
    {
      "debut": 52.76,
      "fin": 55.86,
      "texte": "Et Ronaldo, on s'en bat les couilles, inscris-le au centre de formation de Saint-Etienne !"
    },
    {
      "debut": 55.86,
      "fin": 57.34,
      "texte": "Ce fils de pute avait un plan depuis le début."
    },
    {
      "debut": 57.46,
      "fin": 58.7,
      "texte": "Il voulait que Messi soit meilleur que moi."
    },
    {
      "debut": 58.84,
      "fin": 60.84,
      "texte": "Je promets que je vais faire tout ce qui est possible pour que ça n'arrive pas."
    },
    {
      "debut": 60.94,
      "fin": 62.7,
      "texte": "Il va voir à quel point je suis fort et il va regretter."
    },
    {
      "debut": 62.82,
      "fin": 64.22,
      "texte": "Je vais partir à Manchester United m'entraîner."
    },
    {
      "debut": 64.22,
      "fin": 66.74,
      "texte": "J'ai plus besoin des cailloux et du pain éclaté au sol que ce fils de pute me donne."
    },
    {
      "debut": 66.88,
      "fin": 69.66,
      "texte": "Il va voir, je vais devenir le meilleur joueur du monde et je vais tacler Messi dans tous les matchs."
    }
  ],
