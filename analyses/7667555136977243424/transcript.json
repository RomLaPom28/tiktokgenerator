{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 4.98,
      "texte": "Tu voulais être la plus belle pour ton mariage, Mélanie. Regarde-toi maintenant. Bon mariage, grosse baleine."
    },
    {
      "debut": 5.22,
      "fin": 7.9,
      "texte": "Cléa, qu'as-tu fait ? Mon mariage commence dans cinq minutes."
    },
    {
      "debut": 8.28,
      "fin": 11.58,
      "texte": "Ce voile me va beaucoup mieux, ma belle. Je vais te remplacer pour faire la mariée."
    },
    {
      "debut": 11.86,
      "fin": 15.94,
      "texte": "Cléa, tu peux pas me faire ça, c'est mon mariage. C'est le plus beau jour de ma vie."
    },
    {
      "debut": 16.44,
      "fin": 20.3,
      "texte": "Reste bien là, Mélanie. Le marié m'attend et c'est moi qui vais dire oui."
    },
    {
      "debut": 21.0,
      "fin": 25.02,
      "texte": "Cléa, pourquoi tu m'as fait ça ? J'arrive plus à respirer, crois que je vais y passer."
    },
    {
      "debut": 30.04,
      "fin": 34.86,
      "texte": "C'est quoi cette odeur infecte ? Qui a laissé ce morceau de fromage moisi ici ?"
    },
    {
      "debut": 34.86,
      "fin": 38.26,
      "texte": "Attends, mais ça pourrait me sauver. Si je mange ça, je pourrais peut-être me vider au toilette."
    },
    {
      "debut": 38.34,
      "fin": 48.86,
      "texte": "Ça pourrait aussi me tuer. C'est tout ? Je n'ai même pas dégonflé. Mais comment je vais faire ?"
    },
    {
      "debut": 48.86,
      "fin": 52.36,
      "texte": "Je vous déclare mari et femme. Vous pouvez maintenant embrasser la mariée."
    },
    {
      "debut": 52.84,
      "fin": 55.24,
      "texte": "Tu es enfin à moi, mon amour. Tu es la plus belle, Cléa."
    },
    {
      "debut": 55.28,
      "fin": 57.38,
      "texte": "Où est Mélanie ? Pourquoi tu portes son voile ?"
    },
    {
      "debut": 57.38,
      "fin": 59.5,
      "texte": "Elle est partie. De toute façon, elle ne t'aime pas."
    }
  ],
