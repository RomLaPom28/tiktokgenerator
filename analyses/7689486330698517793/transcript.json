{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.3,
      "fin": 4.02,
      "texte": "Attends, quoi ? Ce bébé, il est plus intelligent que moi, sérieux ?"
    },
    {
      "debut": 4.02,
      "fin": 5.96,
      "texte": "Si le daron voit ça, mon respect dans cette baraque y tombe direct."
    },
    {
      "debut": 6.42,
      "fin": 8.62,
      "texte": "Faut que je planque son vrai QI et que je lui colle un score de ouf en bas, tranquille."
    },
    {
      "debut": 8.8,
      "fin": 9.92,
      "texte": "Voilà, là c'est nickel."
    },
    {
      "debut": 10.56,
      "fin": 12.56,
      "texte": "Toi tu vas valoir le moins cher de la maison, mon grand."
    },
    {
      "debut": 13.16,
      "fin": 14.9,
      "texte": "Et mon petit 40QI, toi t'es mon chouchou."
    },
    {
      "debut": 15.28,
      "fin": 16.86,
      "texte": "J'ai grave de l'amour pour toi, tranquille."
    },
    {
      "debut": 16.98,
      "fin": 18.42,
      "texte": "Pour moi vous êtes à égalité tous les deux."
    },
    {
      "debut": 18.94,
      "fin": 21.22,
      "texte": "Je vais jamais vous juger sur un score de QI à la con."
    },
    {
      "debut": 21.9,
      "fin": 23.02,
      "texte": "Vous êtes mon sang tous les deux."
    },
    {
      "debut": 23.32,
      "fin": 24.68,
      "texte": "Et je vous aime pareil, quoi qu'il arrive."
    },
    {
      "debut": 24.86,
      "fin": 27.96,
      "texte": "On va mettre mon petit 40QI dans le cours privé de bourge."
    },
    {
      "debut": 27.96,
      "fin": 30.74,
      "texte": "Il est carrément plus futé que le 20QI là-bas."
    },
    {
      "debut": 30.94,
      "fin": 33.36,
      "texte": "Donc lui, il aura l'éducation haut de gamme, la vraie."
    },
    {
      "debut": 33.54,
      "fin": 36.36,
      "texte": "Le privé, c'est que pour mon 40QI, l'autre y suivra ailleurs."
    },
    {
      "debut": 36.56,
      "fin": 37.36,
      "texte": "Non mais wesh, c'est mort."
    },
    {
      "debut": 37.44,
      "fin": 38.52,
      "texte": "Les deux gamins, ils vont dans la même école."
    },
    {
      "debut": 38.7,
      "fin": 40.16,
      "texte": "Je vais pas faire de chouchou pour des chiffres de QI."
    },
    {
      "debut": 40.26,
      "fin": 41.68,
      "texte": "C'est mon sang tous les deux et je les tiens pareil."
    },
    {
      "debut": 41.86,
      "fin": 43.86,
      "texte": "Allez les gars, aujourd'hui c'est votre premier jour d'école, fiston."
    },
    {
      "debut": 44.14,
      "fin": 46.7,
      "texte": "Vous allez passer un test et le score, il va décider votre rang dans la classe."
    },
    {
      "debut": 46.98,
      "fin": 48.64,
      "texte": "Donc vous vous concentrez et vous gérez ce test à fond."
    },
    {
      "debut": 48.96,
      "fin": 50.3,
      "texte": "Je sais que vous allez le déchirer, tranquille."
    },
    {
      "debut": 50.5,
      "fin": 52.72,
      "texte": "Bon les élèves, on se concentre, évite !"
    },
    {
      "debut": 52.72,
      "fin": 55.16,
      "texte": "20QI et 40QI, vous allez vous battre pour le rang de la classe."
    },
    {
      "debut": 55.44,
      "fin": 57.04,
      "texte": "Donnez tout et craquez pas sous la pression."
    },
    {
      "debut": 57.36,
      "fin": 58.64,
      "texte": "Allez, on y va, maintenant !"
    },
    {
      "debut": 58.64,
      "fin": 60.6,
      "texte": "Une seconde, il a tout bon, absolument tout."
    },
    {
      "debut": 61.04,
      "fin": 61.9,
      "texte": "Ce badge, c'est du bidon."
    },
    {
      "debut": 62.06,
      "fin": 63.06,
      "texte": "Quelqu'un a trafiqué son score."
    },
    {
      "debut": 63.42,
      "fin": 64.78,
      "texte": "Voilà son vrai QI, 167."
    },
    {
      "debut": 64.9,
      "fin": 66.0,
      "texte": "Le petit génie de toute l'école, c'est lui."
    }
  ],
