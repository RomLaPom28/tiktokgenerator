{
  "langue": "fr",
  "phrases": [
    {
      "debut": 1.49,
      "fin": 4.23,
      "texte": "Tu piques trop, c'est fini, je ne peux pas."
    },
    {
      "debut": 7.52,
      "fin": 9.6,
      "texte": "C'est la 47ème fois que j'entends ça."
    },
    {
      "debut": 10.78,
      "fin": 12.26,
      "texte": "Je coupe mes épines chaque soir."
    },
    {
      "debut": 12.98,
      "fin": 14.66,
      "texte": "Et chaque matin, elles ont repoussé."
    },
    {
      "debut": 17.64,
      "fin": 19.34,
      "texte": "Elle dit qu'elle adore les cactus."
    },
    {
      "debut": 20.58,
      "fin": 22.74,
      "texte": "Je te préviens, je pique vraiment beaucoup."
    },
    {
      "debut": 23.66,
      "fin": 24.42,
      "texte": "Donne-moi ta main."
    },
    {
      "debut": 25.0,
      "fin": 26.26,
      "texte": "Ça ne te fait pas mal ?"
    },
    {
      "debut": 27.46,
      "fin": 29.02,
      "texte": "Moi, je guéris ce qui pique."
    },
    {
      "debut": 30.76,
      "fin": 32.9,
      "texte": "Personne ne m'avait jamais serré dans ses bras."
    },
    {
      "debut": 33.5,
      "fin": 34.82,
      "texte": "Alors, je ne te lâche plus."
    },
    {
      "debut": 35.86,
      "fin": 37.86,
      "texte": "Mes épines, elles tombent."
    },
    {
      "debut": 40.76,
      "fin": 42.5,
      "texte": "Regarde, je suis presque lisse."
    },
    {
      "debut": 43.34,
      "fin": 44.78,
      "texte": "Tu as l'air si pâle."
    },
    {
      "debut": 45.58,
      "fin": 47.22,
      "texte": "Je me sens juste un peu léger."
    },
    {
      "debut": 50.49,
      "fin": 51.95,
      "texte": "Tes épines gardaient ton eau."
    },
    {
      "debut": 52.37,
      "fin": 53.55,
      "texte": "Sans elles, tu t'assèches."
    },
    {
      "debut": 53.71,
      "fin": 55.29,
      "texte": "Combien il m'en reste, docteur ?"
    },
    {
      "debut": 56.55,
      "fin": 57.91,
      "texte": "Il m'en reste, docteur."
    },
    {
      "debut": 58.19,
      "fin": 58.95,
      "texte": "Une par jour."
    },
    {
      "debut": 60.85,
      "fin": 63.13,
      "texte": "Le docteur dit que tout va bien, juste de la fatigue."
    },
    {
      "debut": 63.53,
      "fin": 64.27,
      "texte": "Alors, rentrons."
    },
    {
      "debut": 67.27,
      "fin": 69.63,
      "texte": "Sept épines pour lui, sept feuilles pour moi."
    }
  ],
