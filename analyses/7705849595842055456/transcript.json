{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 2.24,
      "texte": "Euh, ton pied, là ! Il est sur ma tête !"
    },
    {
      "debut": 2.24,
      "fin": 2.74,
      "texte": "Je sais."
    },
    {
      "debut": 3.14,
      "fin": 4.54,
      "texte": "C'est de la triche, ça !"
    },
    {
      "debut": 4.54,
      "fin": 7.8,
      "texte": "Le règlement dit, interdit de tomber, pas interdit de mettre son pied."
    },
    {
      "debut": 8.48,
      "fin": 11.82,
      "texte": "Incroyable ! Le haricot vert utilise la technique du pied !"
    },
    {
      "debut": 11.82,
      "fin": 15.72,
      "texte": "Allez, petit, fais-le tomber ! J'ai parié 50 euros sur toi !"
    },
    {
      "debut": 15.72,
      "fin": 17.64,
      "texte": "Je te donne 100 euros et tu lâches."
    },
    {
      "debut": 17.76,
      "fin": 19.88,
      "texte": "100 euros ? Il y a un million à gagner, idiot !"
    },
    {
      "debut": 19.88,
      "fin": 21.98,
      "texte": "Tu crois qu'on peut se faire livrer une pizza, ici ?"
    },
    {
      "debut": 21.98,
      "fin": 23.08,
      "texte": "T'es sérieux, là ?"
    },
    {
      "debut": 23.08,
      "fin": 25.18,
      "texte": "Chérie, on rentre, il est minuit."
    },
    {
      "debut": 25.48,
      "fin": 26.44,
      "texte": "Tu bouges, je te quitte."
    },
    {
      "debut": 26.62,
      "fin": 29.04,
      "texte": "Moi, demain, je me lève à 6h pour bosser."
    },
    {
      "debut": 29.04,
      "fin": 30.4,
      "texte": "Ah ouais ? Tu fais quoi ?"
    },
    {
      "debut": 30.4,
      "fin": 31.6,
      "texte": "Livreur de pizza."
    },
    {
      "debut": 32.06,
      "fin": 35.06,
      "texte": "Attends ! C'est toi qui devais me livrer ma pizza, ce matin ?"
    },
    {
      "debut": 35.06,
      "fin": 38.2,
      "texte": "Mesdames et messieurs, je ferme juste les yeux deux minutes."
    },
    {
      "debut": 39.32,
      "fin": 41.64,
      "texte": "Encore lui ! Toujours accroché, ce petit !"
    },
    {
      "debut": 41.64,
      "fin": 42.82,
      "texte": "Bon, j'éteins tout."
    },
    {
      "debut": 44.24,
      "fin": 45.22,
      "texte": "Je bouge pas."
    },
    {
      "debut": 45.58,
      "fin": 47.8,
      "texte": "Tu vas faire quoi avec le million, toi ?"
    },
    {
      "debut": 47.8,
      "fin": 49.14,
      "texte": "J'ai acheté ma propre pizzeria."
    },
    {
      "debut": 49.52,
      "fin": 50.98,
      "texte": "Comme ça, plus besoin d'attendre le livreur."
    },
    {
      "debut": 51.24,
      "fin": 52.98,
      "texte": "Ça fait 15 ans que je suis jamais tombé."
    },
    {
      "debut": 53.26,
      "fin": 54.54,
      "texte": "C'est pas ce soir que ça va changer."
    },
    {
      "debut": 54.9,
      "fin": 56.4,
      "texte": "Ouais, ouais, bonne nuit, le grand."
    },
    {
      "debut": 57.48,
      "fin": 57.92,
      "texte": "Hum..."
    },
    {
      "debut": 57.92,
      "fin": 61.85,
      "texte": "Attends, il dort !"
    },
    {
      "debut": 61.85,
      "fin": 63.69,
      "texte": "C'est pas possible ! Il dort !"
    },
    {
      "debut": 63.69,
      "fin": 65.23,
      "texte": "Il est complètement malade !"
    },
    {
      "debut": 65.23,
      "fin": 66.39,
      "texte": "Il a gagné !"
    },
    {
      "debut": 66.39,
      "fin": 68.05,
      "texte": "Hein ? Quoi ?"
    }
