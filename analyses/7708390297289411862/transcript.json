  "phrases": [
    {
      "debut": 1.01,
      "fin": 4.03,
      "texte": "T'as perdu, ferme-la, je passe demain."
    },
    {
      "debut": 7.08,
      "fin": 9.42,
      "texte": "Ton petit frère est dans ma voiture, viens seul."
    },
    {
      "debut": 15.24,
      "fin": 16.7,
      "texte": "J'arrive, touche le pas."
    },
    {
      "debut": 18.44,
      "fin": 22.56,
      "texte": "La fédération a vu la vidéo, une bagarre de plus et c'est fini, pour toujours."
    },
    {
      "debut": 23.74,
      "fin": 24.88,
      "texte": "C'est mon frère coach."
    },
    {
      "debut": 36.64,
      "fin": 39.52,
      "texte": "Regarde qui voilà, le grand frère est venu."
    },
    {
      "debut": 40.34,
      "fin": 42.74,
      "texte": "T'es venu seul, t'es moins bête que mon cousin."
    },
    {
      "debut": 44.72,
      "fin": 47.96,
      "texte": "Le champion de France, si tu te bats tu perds ta licence."
    },
    {
      "debut": 48.9,
      "fin": 52.12,
      "texte": "Tu te bats pas, tu revois plus jamais ton frère."
    },
    {
      "debut": 65.71,
      "fin": 67.93,
      "texte": "J'ai jamais eu besoin d'une carte pour me battre."
    }
