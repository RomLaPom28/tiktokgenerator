{
  "langue": "fr",
  "phrases": [
    {
      "debut": 1.84,
      "fin": 4.6,
      "texte": "Écoute-moi bien fiston, cette raquette tu la gardes tout le temps."
    },
    {
      "debut": 4.8,
      "fin": 6.38,
      "texte": "Mais papa elle est beaucoup trop lourde."
    },
    {
      "debut": 6.6,
      "fin": 8.54,
      "texte": "Tu l'enlèveras seulement le jour du grand tournoi."
    },
    {
      "debut": 8.7,
      "fin": 9.62,
      "texte": "Je te le promets papa."
    },
    {
      "debut": 12.22,
      "fin": 13.28,
      "texte": "C'est quoi ce truc là ?"
    },
    {
      "debut": 13.78,
      "fin": 15.3,
      "texte": "Enlève-moi ce ciment tout de suite !"
    },
    {
      "debut": 15.3,
      "fin": 17.04,
      "texte": "Je peux pas coach, j'ai promis à mon père."
    },
    {
      "debut": 17.18,
      "fin": 18.8,
      "texte": "Tu vas jamais pouvoir jouer avec ça."
    },
    {
      "debut": 19.06,
      "fin": 19.76,
      "texte": "On verra bien."
    },
    {
      "debut": 21.2,
      "fin": 22.38,
      "texte": "Hé le boulet !"
    },
    {
      "debut": 22.38,
      "fin": 25.18,
      "texte": "T'as mis du béton dans ton sac ou quoi ?"
    },
    {
      "debut": 25.18,
      "fin": 26.48,
      "texte": "Rigole bien, un jour vous allez comprendre."
    },
    {
      "debut": 26.56,
      "fin": 28.34,
      "texte": "Le seul truc qu'on va comprendre c'est que t'es nul."
    },
    {
      "debut": 28.86,
      "fin": 29.52,
      "texte": "On verra."
    },
    {
      "debut": 30.46,
      "fin": 32.22,
      "texte": "Papa, tout le monde se moque de moi."
    },
    {
      "debut": 32.22,
      "fin": 34.14,
      "texte": "Je gagne même pas un seul échange."
    },
    {
      "debut": 34.52,
      "fin": 36.72,
      "texte": "Pourquoi je dois garder ce ciment ?"
    },
    {
      "debut": 36.72,
      "fin": 38.0,
      "texte": "Fais-moi confiance fiston."
    },
    {
      "debut": 38.28,
      "fin": 40.02,
      "texte": "Le jour du tournoi tu comprendras tout."
    },
    {
      "debut": 41.16,
      "fin": 42.58,
      "texte": "Tu vas perdre en deux minutes boulet."
    },
    {
      "debut": 43.66,
      "fin": 44.88,
      "texte": "Papa m'a dit que c'était le moment."
    },
    {
      "debut": 48.2,
      "fin": 49.8,
      "texte": "Attends, il a quoi dans les mains ?"
    },
    {
      "debut": 50.86,
      "fin": 52.78,
      "texte": "Prends ça petit poire !"
    },
    {
      "debut": 54.58,
      "fin": 56.38,
      "texte": "Prends ça petit poire, trop facile."
    },
    {
      "debut": 57.0,
      "fin": 58.88,
      "texte": "Attends, c'était quoi ça ?"
    },
    {
      "debut": 58.88,
      "fin": 59.82,
      "texte": "Quinze zéros."
    },
    {
      "debut": 61.99,
      "fin": 64.23,
      "texte": "C'est pas possible, il est cent fois plus rapide !"
    },
    {
      "debut": 64.23,
      "fin": 66.33,
      "texte": "Il s'est entraîné avec du ciment coach."
    },
    {
      "debut": 67.37,
      "fin": 69.03,
      "texte": "Alors c'est qui le boulet maintenant ?"
