{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.18,
      "fin": 4.16,
      "texte": "Ouais je suis obligé de mettre un filtre tellement on voit tes boutons tout blanc c'est abusé"
    },
    {
      "debut": 4.16,
      "fin": 6.08,
      "texte": "Si je te fais autant honte bah quitte-moi Kiwito"
    },
    {
      "debut": 6.08,
      "fin": 9.62,
      "texte": "Frérot même avec un pot de peinture sur la tronche elle ressemble à une calculatrice wesh"
    },
    {
      "debut": 9.62,
      "fin": 11.98,
      "texte": "Si ça m'a dit elle a toujours cette tête elle peut oublier l'invitation au mariage ça c'est sûr"
    },
    {
      "debut": 11.98,
      "fin": 16.56,
      "texte": "Je peux plus me le voir ce mec il fait que me tailler et m'enfoncer devant ses potes l'enfoiré"
    },
    {
      "debut": 16.56,
      "fin": 19.58,
      "texte": "Continue de te foutre de moi Kiwito je vais te faire bouffer mes boutons tu vas voir"
    },
    {
      "debut": 20.26,
      "fin": 25.42,
      "texte": "Voilà toutes les crèmes que j'ai testé madame et rien ne marche 500 euros dans le vent et j'ai toujours la même tronche c'est génial"
    },
    {
      "debut": 25.42,
      "fin": 27.94,
      "texte": "Nan mais oublie tes crèmes de chez action il te faut un vrai traitement violetta"
    },
    {
      "debut": 27.94,
      "fin": 31.24,
      "texte": "T'es enfin rentré violetta un conseil samedi que maquille pas on voit aucune différence avec ou sans maquillage"
    },
    {
      "debut": 31.24,
      "fin": 33.76,
      "texte": "J'ai l'impression de manger tes boutons d'acné ça me dégoûte"
    },
    {
      "debut": 33.76,
      "fin": 35.88,
      "texte": "Change de tronche pour le mariage de mon pote sinon tu vas faire chauffer"
    },
    {
      "debut": 35.88,
      "fin": 38.2,
      "texte": "Arrête de me vanner tu commences vraiment à me gavé pour de bon vieux mec"
    },
    {
      "debut": 38.2,
      "fin": 43.22,
      "texte": "Mon mec m'a dit de changer de tête pour le mariage de son pote sinon je viens pas je veux une peau parfaite qu'il ferme enfin sa gueule"
    },
    {
      "debut": 43.22,
      "fin": 46.14,
      "texte": "J'ai capté j'ai une idée qui pourrait faire l'affaire pour tes boutons ma belle"
    },
    {
      "debut": 46.14,
      "fin": 50.54,
      "texte": "Tu vois ce produit violetta il est spécial en même pas 24 heures ton visage sera une peau de bébé"
    },
    {
      "debut": 50.54,
      "fin": 54.46,
      "texte": "Nan vous blaguez c'est pas possible mais nan je suis pas invité au mariage"
    },
    {
      "debut": 54.46,
      "fin": 57.4,
      "texte": "En plus de ça il traite de boules au fromage devant son pote c'est une enflure lui"
    },
    {
      "debut": 57.78,
      "fin": 60.44,
      "texte": "Parfait ça tombe à pique ma chérie passons aux choses sérieuses maintenant"
    },
    {
      "debut": 60.44,
      "fin": 66.1,
      "texte": "Ah oui tu dois savoir une chose sur ce traitement il y a un effet secondaire on le fait quand même ou tu veux qu'on arrête là"
    }
  ],
