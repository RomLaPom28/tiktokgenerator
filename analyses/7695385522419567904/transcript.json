{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.18,
      "fin": 3.5,
      "texte": "Qu'est-ce que tu ferais si tu avais de l'argent en illimité ?"
    },
    {
      "debut": 3.5,
      "fin": 5.72,
      "texte": "Je boirais du meilleux vin, je dormirais avec une femme différente chaque nuit"
    },
    {
      "debut": 5.72,
      "fin": 7.74,
      "texte": "et je roulerais dans les plus belles voitures du monde !"
    },
    {
      "debut": 7.74,
      "fin": 9.6,
      "texte": "Je peux te donner sept ans !"
    },
    {
      "debut": 9.6,
      "fin": 10.54,
      "texte": "C'est quoi l'arnaque ?"
    },
    {
      "debut": 10.54,
      "fin": 12.96,
      "texte": "Le diable ne donne jamais rien sans contrepartie !"
    },
    {
      "debut": 12.96,
      "fin": 14.68,
      "texte": "Pendant sept ans, tu auras de l'argent en illimité."
    },
    {
      "debut": 15.02,
      "fin": 16.64,
      "texte": "Mais après ce temps, tu me donneras ton âme."
    },
    {
      "debut": 17.24,
      "fin": 17.9,
      "texte": "J'accepte !"
    },
    {
      "debut": 17.9,
      "fin": 20.52,
      "texte": "De toute manière, ma vie ne peut pas être pire que maintenant !"
    },
    {
      "debut": 20.52,
      "fin": 22.18,
      "texte": "Demain, tu te réveilleras riche !"
    },
    {
      "debut": 23.9,
      "fin": 27.42,
      "texte": "Il ne m'a pas menti ! Je suis riche !"
    },
    {
      "debut": 27.42,
      "fin": 29.36,
      "texte": "Ça fait seulement deux ans que j'ai pacté !"
    },
    {
      "debut": 29.36,
      "fin": 31.36,
      "texte": "Il me reste encore plein de temps !"
    },
    {
      "debut": 32.66,
      "fin": 36.54,
      "texte": "C'est génial ! Il me reste encore deux ans avant que le diable revienne !"
    },
    {
      "debut": 36.54,
      "fin": 38.36,
      "texte": "J'aime trop ma vie !"
    },
    {
      "debut": 39.22,
      "fin": 42.64,
      "texte": "Sept ans sont passés et dans 48 heures, je viendrai récupérer mon dû."
    },
    {
      "debut": 43.04,
      "fin": 44.76,
      "texte": "Mais qu'est-ce que tu fous là ? Il me reste 48 heures !"
    },
    {
      "debut": 44.76,
      "fin": 46.16,
      "texte": "Dégage d'ici toi !"
    },
    {
      "debut": 46.16,
      "fin": 47.46,
      "texte": "Seulement 48 heures !"
    },
    {
      "debut": 48.36,
      "fin": 51.52,
      "texte": "Je suis dans la merde ! J'ai fait un deal avec le diable !"
    },
    {
      "debut": 51.52,
      "fin": 53.38,
      "texte": "Il vous reste combien de temps ?"
    },
    {
      "debut": 53.38,
      "fin": 54.7,
      "texte": "48 heures !"
    },
    {
      "debut": 54.7,
      "fin": 57.12,
      "texte": "Tenez, prenez ça et mettez en autour de votre maison !"
    },
    {
      "debut": 57.12,
      "fin": 59.0,
      "texte": "Le diable ne pourra pas rentrer, c'est du sel béni !"
    },
    {
      "debut": 59.0,
      "fin": 60.0,
      "texte": "Faites-moi confiance !"
    },
    {
      "debut": 65.62,
      "fin": 67.38,
      "texte": "Je vois, donc tu essaies de m'arnaquer ?"
    },
    {
      "debut": 67.38,
      "fin": 70.34,
      "texte": "Personne ne peut arnaquer le diable, je vais rester ici jusqu'à ce que tu sortes !"
    },
    {
      "debut": 70.34,
      "fin": 72.72,
      "texte": "Vas-y, pas de soucis ! Profite bien de la vue, trou de balles !"
    }
  ],
