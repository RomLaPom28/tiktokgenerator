{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 3.28,
      "texte": "Tout le monde croit que je pèse 150 kilos, même mon ex."
    },
    {
      "debut": 3.7,
      "fin": 5.6,
      "texte": "Ce soir, je passe en direct à la télé."
    },
    {
      "debut": 6.04,
      "fin": 8.02,
      "texte": "Et toute la France va découvrir la vraie Jade."
    },
    {
      "debut": 8.58,
      "fin": 11.26,
      "texte": "Ce soir, la mannequin la plus demandée de France est avec nous, Jade."
    },
    {
      "debut": 11.58,
      "fin": 13.86,
      "texte": "Merci, je suis tellement heureuse d'être enfin sur ce plateau."
    },
    {
      "debut": 14.26,
      "fin": 16.12,
      "texte": "On dit que vous vous mariez très bientôt, c'est vrai ?"
    },
    {
      "debut": 16.12,
      "fin": 18.36,
      "texte": "Oui, avec un homme qui m'a aimée avant tout ça."
    },
    {
      "debut": 18.68,
      "fin": 20.98,
      "texte": "Yanis, regarde la télé, c'est pas ta Jade la mannequin là ?"
    },
    {
      "debut": 20.98,
      "fin": 23.4,
      "texte": "Impossible maman, elle faisait 150 kilos, je te jure."
    },
    {
      "debut": 23.6,
      "fin": 26.2,
      "texte": "Une femme en or, et toi imbécile tu la laissais partir ?"
    },
    {
      "debut": 26.2,
      "fin": 28.36,
      "texte": "Je vais la récupérer, ce mariage il aura pas lieu."
    },
    {
      "debut": 28.36,
      "fin": 31.56,
      "texte": "Roule plus vite Yanis, le mariage commence dans 10 minutes !"
    },
    {
      "debut": 31.56,
      "fin": 34.6,
      "texte": "T'inquiète maman, elle va jamais dire oui à son petit serveur."
    },
    {
      "debut": 34.92,
      "fin": 37.46,
      "texte": "Jade, cette villa, la piscine, tous ses invités, c'est à toi ?"
    },
    {
      "debut": 37.46,
      "fin": 40.04,
      "texte": "Non Malik, à partir d'aujourd'hui tout ça c'est à nous deux."
    },
    {
      "debut": 40.22,
      "fin": 41.98,
      "texte": "Moi je t'aurais épousé dans mon petit café tu sais."
    },
    {
      "debut": 42.34,
      "fin": 44.4,
      "texte": "Je sais, c'est pour ça que c'est toi que j'épouse."
    },
    {
      "debut": 44.74,
      "fin": 47.14,
      "texte": "Je t'ai aimé avec 150 kilos, je t'aimerais toute ma vie Jade."
    },
    {
      "debut": 47.34,
      "fin": 49.32,
      "texte": "Et moi je t'ai choisi parce que t'as jamais regardé mon argent."
    },
    {
      "debut": 49.62,
      "fin": 53.1,
      "texte": "Jade, arrête tout ! Ce mariage il peut pas avoir lieu, je t'aime encore !"
    },
    {
      "debut": 53.1,
      "fin": 55.58,
      "texte": "Jade je t'en supplie donne-moi une deuxième chance, je t'aime vraiment !"
    },
    {
      "debut": 55.58,
      "fin": 57.92,
      "texte": "Tu m'aimais pas quand je faisais 150 kilos Yanis."
    },
    {
      "debut": 58.06,
      "fin": 60.58,
      "texte": "J'étais bête d'accord mais regarde je suis venu jusqu'ici pour toi !"
    },
    {
      "debut": 60.58,
      "fin": 63.02,
      "texte": "Trop tard, cette fois le test c'est toi qui l'as raté."
    },
    {
      "debut": 63.36,
      "fin": 65.86,
      "texte": "Imbécile, c'était une femme en or et tu l'as laissé partir."
    },
    {
      "debut": 66.16,
      "fin": 68.84,
      "texte": "Je sais maman, mais crois moi cette histoire elle est pas finie."
    }
  ],
