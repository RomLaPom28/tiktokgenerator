{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 1.6,
      "texte": "Mon cœur fait attention de ne pas glisser."
    },
    {
      "debut": 1.78,
      "fin": 3.14,
      "texte": "Ah, je tombe ! Aide-moi !"
    },
    {
      "debut": 3.14,
      "fin": 4.08,
      "texte": "J'arrive !"
    },
    {
      "debut": 6.08,
      "fin": 8.22,
      "texte": "Mon amour, tu vas me manquer pour toujours."
    },
    {
      "debut": 8.76,
      "fin": 10.6,
      "texte": "Tu as laissé des alocots pour nos enfants."
    },
    {
      "debut": 10.86,
      "fin": 11.3,
      "texte": "Merci."
    },
    {
      "debut": 12.32,
      "fin": 14.84,
      "texte": "Mangez, mes enfants, papa a laissé plein d'alocots."
    },
    {
      "debut": 15.2,
      "fin": 18.5,
      "texte": "Maman, c'est trop bon ! Mais il est où, papa ?"
    },
    {
      "debut": 18.5,
      "fin": 20.68,
      "texte": "Papa est parti travailler à l'étranger."
    },
    {
      "debut": 21.62,
      "fin": 23.0,
      "texte": "Il vous a laissé tout ça."
    },
    {
      "debut": 25.28,
      "fin": 26.62,
      "texte": "Je dois nourrir mes enfants."
    },
    {
      "debut": 27.36,
      "fin": 28.94,
      "texte": "Je vais vendre les alocots de papa."
    },
    {
      "debut": 29.84,
      "fin": 32.48,
      "texte": "Venez goûter les alocots de papa, bien dorés."
    },
    {
      "debut": 32.68,
      "fin": 34.12,
      "texte": "À n'acheter un offert."
    },
    {
      "debut": 34.32,
      "fin": 36.1,
      "texte": "Miam, trop bon, j'en veux !"
    },
    {
      "debut": 36.1,
      "fin": 38.74,
      "texte": "Merci mon amour, grâce à toi, je suis riche."
    },
    {
      "debut": 38.9,
      "fin": 40.84,
      "texte": "Nos enfants ne manqueront jamais de rien."
    },
    {
      "debut": 42.02,
      "fin": 43.62,
      "texte": "Je suis passée d'un petit stand"
    },
    {
      "debut": 43.62,
      "fin": 46.18,
      "texte": "à l'un des meilleurs restaurants d'alocots du monde."
    },
    {
      "debut": 46.88,
      "fin": 47.8,
      "texte": "Grâce à mon homme."
    },
    {
      "debut": 48.78,
      "fin": 50.32,
      "texte": "Table 5, 10 portions d'alocots."
    },
    {
      "debut": 50.84,
      "fin": 52.04,
      "texte": "Les meilleurs alocots du monde."
    },
    {
      "debut": 52.62,
      "fin": 53.68,
      "texte": "Mes affaires marchent bien."
    },
    {
      "debut": 54.18,
      "fin": 55.52,
      "texte": "Patronne, on a un gros problème."
    },
    {
      "debut": 55.78,
      "fin": 57.44,
      "texte": "Plus de stock d'alocots, c'est les commandes arrivent."
    },
    {
      "debut": 57.44,
      "fin": 60.26,
      "texte": "Quoi ? Comment je fais, maintenant ?"
    },
    {
      "debut": 60.26,
      "fin": 62.36,
      "texte": "Je sais pas, mais trouvez vite une solution."
    },
    {
      "debut": 62.9,
      "fin": 65.76,
      "texte": "Oh non, oh non, oh non, vite !"
    },
    {
      "debut": 67.12,
      "fin": 68.88,
      "texte": "Je crois que j'ai une idée."
    }
