{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.27,
      "fin": 6.33,
      "texte": "Wesh, une McLaren elle fout quoi ici ? Celui qui l'a abandonné il n'a vraiment pas conscience de ce qu'il vient de faire c'est pas possible !"
    },
    {
      "debut": 6.33,
      "fin": 9.53,
      "texte": "Bonjour monsieur, elle a combien la McLaren bleue là-bas ? Tu parles de cette carcasse ?"
    },
    {
      "debut": 9.53,
      "fin": 10.87,
      "texte": "Oui elle m'intéresse je veux l'acheter."
    },
    {
      "debut": 11.09,
      "fin": 12.43,
      "texte": "Ok pour 100 balles elle est à toi gamin."
    },
    {
      "debut": 12.59,
      "fin": 14.21,
      "texte": "Je vous la prends cash en espèce !"
    },
    {
      "debut": 14.21,
      "fin": 16.33,
      "texte": "La signe ce papier et cette voiture t'appartient gamin."
    },
    {
      "debut": 16.51,
      "fin": 17.37,
      "texte": "Ok je signe monsieur."
    },
    {
      "debut": 17.77,
      "fin": 20.09,
      "texte": "Par contre pour la ramener chez toi tu te débrouilles solo je te préviens."
    },
    {
      "debut": 20.19,
      "fin": 22.09,
      "texte": "Bah alors banano t'es encore venu en bus à ce que je vois MDR."
    },
    {
      "debut": 22.57,
      "fin": 24.33,
      "texte": "Rigole mon pote je viens d'acheter une McLaren wesh !"
    },
    {
      "debut": 24.33,
      "fin": 25.87,
      "texte": "Tu sais quoi mec je te crois même pas t'es un mec pauvre."
    },
    {
      "debut": 25.87,
      "fin": 28.13,
      "texte": "J'mite au pas ! Attends que je la remette en état tu vas choquer mon gars quand tu vas la voir."
    },
    {
      "debut": 28.29,
      "fin": 30.69,
      "texte": "T'as acheté cette épave pour 100 euros sérieux ?"
    },
    {
      "debut": 30.69,
      "fin": 32.73,
      "texte": "Bah oui j'ai fait une bonne affaire non ?"
    },
    {
      "debut": 32.73,
      "fin": 35.63,
      "texte": "Mais t'es bête tu vas payer cher pour la réparer t'es au courant ?"
    },
    {
      "debut": 35.63,
      "fin": 38.09,
      "texte": "T'inquiète je vais m'informer sur le net pas de panique papa."
    },
    {
      "debut": 38.67,
      "fin": 41.11,
      "texte": "Wesh c'est une galère frère je pourrais pas faire ça tout seul."
    },
    {
      "debut": 41.41,
      "fin": 45.51,
      "texte": "Je vais demander à mon poteau d'enfance de m'aider il s'y connait bien en voiture sportive."
    },
    {
      "debut": 46.29,
      "fin": 47.33,
      "texte": "Pas mal ta caisse mec."
    },
    {
      "debut": 47.99,
      "fin": 49.85,
      "texte": "Tu peux faire quelque chose du coup ?"
    },
    {
      "debut": 49.85,
      "fin": 52.35,
      "texte": "Tu vas pas la reconnaître mon gars je gère t'inquiète."
    },
    {
      "debut": 53.39,
      "fin": 55.53,
      "texte": "Alors on va mettre des freins pour commencer ensuite on met des nouvelles roues."
    },
    {
      "debut": 55.53,
      "fin": 57.93,
      "texte": "Et après le plus important un moteur V8 4.0 litre biturbo."
    },
    {
      "debut": 58.07,
      "fin": 60.71,
      "texte": "Et pour le style on finit par un aileron racing state GTR et voilà."
    },
    {
      "debut": 61.09,
      "fin": 62.73,
      "texte": "Bah alors ton épave elle roule toujours pas MDR."
    },
    {
      "debut": 63.05,
      "fin": 64.21,
      "texte": "Tu sais quoi je te propose un duel mec."
    },
    {
      "debut": 64.31,
      "fin": 66.31,
      "texte": "T'ouvre trop ta gorge pour rien je vais te faire redescendre d'un étage."
    },
    {
      "debut": 66.61,
      "fin": 68.29,
      "texte": "Ok celui qui perd donne sa voiture au vainqueur."
    },
    {
      "debut": 68.53,
      "fin": 69.39,
      "texte": "Ok c'est bon pour moi."
    },
    {
      "debut": 70.77,
      "fin": 73.83,
      "texte": "La McLaren sera prête ce soir normalement j'ai hâte de voir son glow up."
    },
    {
      "debut": 73.85,
      "fin": 76.61,
      "texte": "Plus que quelques heures avant de voir le résultat j'ai hâte wesh."
    }
  ],
