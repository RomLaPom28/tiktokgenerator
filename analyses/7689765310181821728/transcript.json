{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.18,
      "fin": 2.8,
      "texte": "Wesh, mais attends, tu portes combien de sacs ?"
    },
    {
      "debut": 2.8,
      "fin": 3.92,
      "texte": "J'en sais rien, j'ai pas compté."
    },
    {
      "debut": 4.44,
      "fin": 5.68,
      "texte": "Fréro, ils font 70 kilos chacun."
    },
    {
      "debut": 8.04,
      "fin": 9.46,
      "texte": "Fréro, t'es vraiment normal toi."
    },
    {
      "debut": 10.14,
      "fin": 11.86,
      "texte": "Bah quoi ? J'ai juste porté quelques sacs."
    },
    {
      "debut": 12.58,
      "fin": 14.76,
      "texte": "Fréro, après cette matinée, j'ai une dalle de malade."
    },
    {
      "debut": 15.16,
      "fin": 16.0,
      "texte": "Attends, regarde là-bas."
    },
    {
      "debut": 16.7,
      "fin": 18.18,
      "texte": "Wesh, c'est quoi ça ?"
    },
    {
      "debut": 18.88,
      "fin": 20.34,
      "texte": "Wesh, 67 millions ?"
    },
    {
      "debut": 20.78,
      "fin": 23.14,
      "texte": "Attends, 67 millions d'euros ?"
    },
    {
      "debut": 23.14,
      "fin": 23.74,
      "texte": "On s'inscrit."
    },
    {
      "debut": 24.78,
      "fin": 26.7,
      "texte": "Vous voulez vraiment participer au concours ?"
    },
    {
      "debut": 26.7,
      "fin": 28.16,
      "texte": "Lui, il va tous les écraser."
    },
    {
      "debut": 28.16,
      "fin": 29.72,
      "texte": "Très bien, vous êtes inscrits."
    },
    {
      "debut": 29.94,
      "fin": 30.72,
      "texte": "Rendez-vous dans la reine."
    },
    {
      "debut": 31.36,
      "fin": 32.7,
      "texte": "On va chercher les 67 millions."
    },
    {
      "debut": 33.9,
      "fin": 35.98,
      "texte": "C'est toi le particpant ?"
    },
    {
      "debut": 35.98,
      "fin": 37.68,
      "texte": "Mettez tout maigre !"
    },
    {
      "debut": 37.68,
      "fin": 38.82,
      "texte": "Profite de rire maintenant."
    },
    {
      "debut": 39.32,
      "fin": 40.58,
      "texte": "J'ai hâte de voir ça."
    },
    {
      "debut": 42.74,
      "fin": 43.82,
      "texte": "Mesdames et messieurs,"
    },
    {
      "debut": 44.76,
      "fin": 45.82,
      "texte": "veuillez bien vous installer."
    },
    {
      "debut": 46.56,
      "fin": 48.06,
      "texte": "Le spectacle va bientôt commencer."
    },
    {
      "debut": 48.74,
      "fin": 50.36,
      "texte": "Alors, c'est vous mes adversaires"
    },
    {
      "debut": 50.36,
      "fin": 52.5,
      "texte": "et vous pensez vraiment pouvoir me battre avec ça ?"
    },
    {
      "debut": 52.5,
      "fin": 53.7,
      "texte": "T'inquiète pas, tu vas vite comprendre."
    },
    {
      "debut": 56.76,
      "fin": 57.8,
      "texte": "Épreuve numéro 1."
    },
    {
      "debut": 58.06,
      "fin": 59.36,
      "texte": "100 kilos pour commencer."
    },
    {
      "debut": 60.16,
      "fin": 62.56,
      "texte": "Et croyez-moi, vous n'êtes pas prêt pour la suite ?"
