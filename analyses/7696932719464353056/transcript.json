{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 1.72,
      "texte": "Enlève ses chaussures et viens avec moi."
    },
    {
      "debut": 2.14,
      "fin": 3.12,
      "texte": "On retourne voir ton coach."
    },
    {
      "debut": 3.66,
      "fin": 6.26,
      "texte": "Coach, laissez mon fils refaire un dernier 100 mètres."
    },
    {
      "debut": 6.3,
      "fin": 9.04,
      "texte": "Désolé, mais en 24 heures, ses chronos ne vont pas changer par miracle."
    },
    {
      "debut": 9.28,
      "fin": 10.74,
      "texte": "Faites-moi confiance, juste une dernière course."
    },
    {
      "debut": 11.04,
      "fin": 12.4,
      "texte": "Bon, si tu insistes."
    },
    {
      "debut": 12.64,
      "fin": 13.96,
      "texte": "Attends, fils, laisse-moi faire."
    },
    {
      "debut": 14.2,
      "fin": 15.96,
      "texte": "Je sais que je t'ai fait souffrir pendant 10 ans."
    },
    {
      "debut": 16.38,
      "fin": 17.26,
      "texte": "Et j'en suis désolé."
    },
    {
      "debut": 17.48,
      "fin": 19.46,
      "texte": "Alors pourquoi tu m'as obligé à faire tout ça ?"
    },
    {
      "debut": 19.46,
      "fin": 20.82,
      "texte": "Dans quelques minutes, tu comprendras."
    },
    {
      "debut": 21.32,
      "fin": 23.58,
      "texte": "J'ai l'impression d'être super léger, c'est génial !"
    },
    {
      "debut": 23.58,
      "fin": 25.7,
      "texte": "Pendant 10 ans, tes jambes ont appris à porter 100 kilos."
    },
    {
      "debut": 25.98,
      "fin": 26.94,
      "texte": "Maintenant, mets celles-là."
    },
    {
      "debut": 27.14,
      "fin": 28.64,
      "texte": "Et cours comme si ta vie en dépendait."
    },
    {
      "debut": 29.14,
      "fin": 30.86,
      "texte": "Vas-y, mon fils, fais-toi confiance."
    },
    {
      "debut": 31.26,
      "fin": 33.54,
      "texte": "3, 2, 1, partez !"
    },
    {
      "debut": 33.54,
      "fin": 35.44,
      "texte": "Putain, j'avais l'impression de voler !"
    },
    {
      "debut": 35.44,
      "fin": 36.64,
      "texte": "Mais c'est impossible !"
    },
    {
      "debut": 36.64,
      "fin": 38.1,
      "texte": "9 secondes 47 !"
    },
    {
      "debut": 38.1,
      "fin": 40.54,
      "texte": "Il vient de battre le record du monde !"
    },
    {
      "debut": 40.54,
      "fin": 42.58,
      "texte": "Léo, samedi, tu seras au départ."
    },
    {
      "debut": 42.78,
      "fin": 44.52,
      "texte": "Tu es sélectionné !"
    },
    {
      "debut": 44.52,
      "fin": 46.88,
      "texte": "Alors, Citron, t'as enfin jeté tes casseroles ?"
    },
    {
      "debut": 46.88,
      "fin": 47.14,
      "texte": "Ouais."
    },
    {
      "debut": 47.66,
      "fin": 49.36,
      "texte": "Et cette fois, c'est toi qui seras dans mon rétro."
    },
    {
      "debut": 53.76,
      "fin": 55.64,
      "texte": "Mais, c'est pas possible !"
    },
    {
      "debut": 59.71,
      "fin": 61.03,
      "texte": "Léo, c'est incroyable !"
    },
    {
      "debut": 61.03,
      "fin": 61.73,
      "texte": "T'as gagné !"
    },
    {
      "debut": 61.73,
      "fin": 64.21,
      "texte": "Les recruteurs se battent déjà pour te signer !"
    },
    {
      "debut": 64.21,
      "fin": 65.41,
      "texte": "Non, j'y crois pas !"
    },
    {
      "debut": 65.41,
      "fin": 68.05,
      "texte": "Plus sérieusement, ta carrière professionnelle commence aujourd'hui."
    },
    {
      "debut": 68.37,
      "fin": 69.05,
      "texte": "Félicitations !"
    },
    {
      "debut": 69.77,
      "fin": 70.93,
      "texte": "Papa, aujourd'hui, j'ai compris."
    },
    {
      "debut": 71.35,
      "fin": 72.67,
      "texte": "Merci d'avoir toujours cru en moi."
    },
    {
      "debut": 72.85,
      "fin": 74.11,
      "texte": "Je suis fier de toi, mon fils."
    },
    {
      "debut": 74.29,
      "fin": 74.85,
      "texte": "Tellement fier."
    },
    {
      "debut": 75.19,
      "fin": 75.99,
      "texte": "Je t'aime, papa."
    },
    {
      "debut": 76.31,
      "fin": 77.05,
      "texte": "Moi aussi, champion."
    }
  ],
