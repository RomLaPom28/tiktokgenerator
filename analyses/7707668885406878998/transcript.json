{
  "langue": "fr",
  "phrases": [
    {
      "debut": 1.2,
      "fin": 6.5,
      "texte": "Bienvenue le nouveau, ici l'entrée c'est 50 balles, touche pas, tu payes pas, pas de sac."
    },
    {
      "debut": 7.36,
      "fin": 8.02,
      "texte": "Enlève ton pied."
    },
    {
      "debut": 8.48,
      "fin": 13.18,
      "texte": "Ilyes non, pas ici, pas devant tout le monde, c'est quoi ça ? Des bandages ? T'as bobo le nouveau ?"
    },
    {
      "debut": 14.88,
      "fin": 18.14,
      "texte": "Demain 50 balles, sinon c'est ton petit frère qui paye."
    },
    {
      "debut": 18.62,
      "fin": 20.36,
      "texte": "Touche-le une fois, tu verras."
    },
    {
      "debut": 20.62,
      "fin": 23.12,
      "texte": "Tu t'es battu ? Dis-moi que tu t'es pas battu."
    },
    {
      "debut": 23.36,
      "fin": 25.48,
      "texte": "Non maman, j'ai promis je touche personne."
    },
    {
      "debut": 26.36,
      "fin": 28.5,
      "texte": "Champion de France et tu te laisses humilier ?"
    },
    {
      "debut": 28.5,
      "fin": 30.88,
      "texte": "Je sais maman, t'inquiète pas."
    },
    {
      "debut": 32.83,
      "fin": 35.07,
      "texte": "Samedi, c'est la sélection pour l'équipe de France."
    },
    {
      "debut": 36.57,
      "fin": 39.23,
      "texte": "Et lui, je le laisse faire jusqu'à samedi ?"
    },
    {
      "debut": 40.57,
      "fin": 43.73,
      "texte": "Une seule bagarre et ta licence saute, tout s'arrête."
    },
    {
      "debut": 51.05,
      "fin": 53.67,
      "texte": "Ton grand frère a pas payé, alors aujourd'hui c'est toi."
    },
    {
      "debut": 54.13,
      "fin": 56.27,
      "texte": "Laisse-moi s'il te plaît, laisse-moi tranquille."
    },
    {
      "debut": 56.99,
      "fin": 59.67,
      "texte": "Ah le grand frère, t'as ramené mes 50 balles ?"
    },
    {
      "debut": 59.67,
      "fin": 62.01,
      "texte": "Rentre à la maison petit, je m'en occupe."
    },
    {
      "debut": 64.95,
      "fin": 67.87,
      "texte": "Quoi ? Tu te prends pour Rocky toi ? Vas-y essaie."
    },
    {
      "debut": 68.79,
      "fin": 70.45,
      "texte": "Tu m'as demandé ce que c'était hier."
    },
    {
      "debut": 71.67,
      "fin": 72.25,
      "texte": "Je vais te montrer."
    }
  ],
