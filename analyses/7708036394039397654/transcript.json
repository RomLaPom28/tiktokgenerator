{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 3.6,
      "texte": "Ton petit frère est parti en chialant. Et toi, tu fais quoi, la victime ?"
    },
    {
      "debut": 4.44,
      "fin": 6.76,
      "texte": "Tu voulais savoir ce que c'était ? Regarde bien."
    },
    {
      "debut": 29.14,
      "fin": 30.62,
      "texte": "Portes tes mains et bats-toi !"
    },
    {
      "debut": 39.01,
      "fin": 41.09,
      "texte": "Derrière toi, tu me cherchais où ?"
    },
    {
      "debut": 47.15,
      "fin": 50.61,
      "texte": "Tout le lycée à la vidéo, Ilyes. Même ton coach l'a vu."
    },
    {
      "debut": 51.83,
      "fin": 54.31,
      "texte": "Il a touché à Lychee. Je regrette rien."
    },
    {
      "debut": 57.82,
      "fin": 62.06,
      "texte": "Cousin, j'ai besoin de toi. C'est grave."
    },
    {
      "debut": 63.88,
      "fin": 66.22,
      "texte": "T'as perdu. Ferme-la. Je passe demain."
    }
  ],
