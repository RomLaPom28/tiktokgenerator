{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.64,
      "fin": 2.0,
      "texte": "Allez encore un effort !"
    },
    {
      "debut": 2.58,
      "fin": 4.48,
      "texte": "Regardez les mecs, c'est ma meuf fraise le squelette."
    },
    {
      "debut": 4.68,
      "fin": 5.94,
      "texte": "Qu'est-ce qu'elle fout là ?"
    },
    {
      "debut": 5.94,
      "fin": 7.56,
      "texte": "On dirait qu'elle veut prendre du poids, mon cœur."
    },
    {
      "debut": 7.64,
      "fin": 9.62,
      "texte": "J't'ai déjà dit que tu étais magnifique comme ça, pourquoi tu viens ici ?"
    },
    {
      "debut": 9.62,
      "fin": 10.62,
      "texte": "Passe plutôt à la maison, j'ai envie d'doro."
    },
    {
      "debut": 10.86,
      "fin": 13.16,
      "texte": "Laisse-moi Kiwi, toi et moi c'est fini, j'ai vu les messages où tu te moquais de mon corps."
    },
    {
      "debut": 13.4,
      "fin": 14.46,
      "texte": "Ça va, c'était pour rire entre mecs."
    },
    {
      "debut": 14.56,
      "fin": 15.76,
      "texte": "Donne-moi deux mois et tu verras."
    },
    {
      "debut": 17.2,
      "fin": 19.92,
      "texte": "Alors comme ça tu veux prendre du poids, je ne te laisserai jamais gagner."
    },
    {
      "debut": 20.16,
      "fin": 22.72,
      "texte": "Tu resteras comme tu es, un squelette vivant."
    },
    {
      "debut": 22.8,
      "fin": 24.14,
      "texte": "Je vais tout faire pour te nuire."
    },
    {
      "debut": 24.2,
      "fin": 25.78,
      "texte": "C'est encore une fois moquer de moi à la salle."
    },
    {
      "debut": 25.78,
      "fin": 27.28,
      "texte": "J'ai l'impression que je ne vais pas pouvoir y arriver."
    },
    {
      "debut": 27.68,
      "fin": 28.74,
      "texte": "Mon cœur est trop blessé."
    },
    {
      "debut": 29.22,
      "fin": 30.68,
      "texte": "Mais qui ça peut être ?"
    },
    {
      "debut": 30.68,
      "fin": 32.82,
      "texte": "Mais qu'est-ce que tu fais ici Kiwi ?"
    },
    {
      "debut": 32.82,
      "fin": 34.98,
      "texte": "Je t'ai ramené des fleurs, tu sais j'ai pas été cool avec toi mais crois-moi,"
    },
    {
      "debut": 35.06,
      "fin": 37.4,
      "texte": "tu es la plus belle fille que j'ai jamais vu et j'ai pas envie que tu deviennes comme les autres."
    },
    {
      "debut": 37.52,
      "fin": 40.78,
      "texte": "C'est mon corps Kiwi, et désormais il ne t'appartient plus alors je te demande de me laisser tranquille et de t'en aller."
    },
    {
      "debut": 41.48,
      "fin": 42.42,
      "texte": "Elle m'appartient ?"
    },
    {
      "debut": 42.42,
      "fin": 44.18,
      "texte": "Il est hors de question qu'elle change physiquement."
    },
    {
      "debut": 44.46,
      "fin": 46.02,
      "texte": "De toute façon c'est impossible qu'elle change."
    },
    {
      "debut": 46.24,
      "fin": 49.28,
      "texte": "Elle restera squelette toute sa vie comme ça, personne d'autre que moi ne voudra d'elle."
    },
    {
      "debut": 49.74,
      "fin": 51.12,
      "texte": "C'est l'heure de la transformation."
    },
    {
      "debut": 56.86,
      "fin": 58.88,
      "texte": "On a toujours dit à Kiwi que tu étais un canon,"
    },
    {
      "debut": 59.04,
      "fin": 61.62,
      "texte": "sors avec moi, tu es la fille la plus belle que j'ai jamais vue."
    },
    {
      "debut": 61.98,
      "fin": 63.38,
      "texte": "Vous avez passé votre temps à me rabaisser,"
    },
    {
      "debut": 63.58,
      "fin": 65.64,
      "texte": "et bien maintenant vous pouvez aller vous mastiquer la nouille les garçons."
    },
    {
      "debut": 66.02,
      "fin": 66.58,
      "texte": "Quoi ?"
    },
    {
      "debut": 68.62,
      "fin": 70.76,
      "texte": "Tu n'as pas osé ! Elle va me le payer !"
    },
    {
      "debut": 70.76,
      "fin": 72.16,
      "texte": "Le jeu commence maintenant !"
    },
    {
      "debut": 72.16,
      "fin": 74.9,
      "texte": "Arrête ta buse, t'as perdu c'est tout, laisse la briller maintenant !"
    },
    {
      "debut": 74.9,
      "fin": 75.18,
      "texte": "Jamais !"
    }
  ],
