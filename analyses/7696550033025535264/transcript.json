{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.58,
      "fin": 3.04,
      "texte": "670 euros d'alarme, et tu dors encore, Péchita !"
    },
    {
      "debut": 3.04,
      "fin": 5.4,
      "texte": "Même cette énorme cloche te réveille pas, c'est pas possible !"
    },
    {
      "debut": 5.96,
      "fin": 7.88,
      "texte": "Un marteau piqueur juste à côté d'elle, et elle dort encore ?"
    },
    {
      "debut": 7.88,
      "fin": 9.04,
      "texte": "J'hallucine complètement !"
    },
    {
      "debut": 9.04,
      "fin": 10.28,
      "texte": "Madame, madame, réveillez-vous enfin !"
    },
    {
      "debut": 10.28,
      "fin": 11.82,
      "texte": "Attends, un million d'euros juste pour dormir ?"
    },
    {
      "debut": 11.82,
      "fin": 12.86,
      "texte": "Je m'inscris direct, moi !"
    },
    {
      "debut": 13.92,
      "fin": 16.86,
      "texte": "Désolée, pour t'inscrire au défi, il faut d'abord la signature de ta mère."
    },
    {
      "debut": 16.96,
      "fin": 19.3,
      "texte": "Ma mère ? Bon, je file la chercher tout de suite !"
    },
    {
      "debut": 19.3,
      "fin": 22.76,
      "texte": "Maman, signe vite ici, c'est un concours de sommeil, je peux gagner un million d'euros !"
    },
    {
      "debut": 22.76,
      "fin": 25.38,
      "texte": "Un million pour dormir ? Tu me prends vraiment pour une idiote, Péchita ?"
    },
    {
      "debut": 25.38,
      "fin": 28.14,
      "texte": "Je te jure que c'est vrai, regarde le papier, c'est écrit en gros !"
    },
    {
      "debut": 28.54,
      "fin": 29.5,
      "texte": "Non, non et non !"
    },
    {
      "debut": 29.5,
      "fin": 31.28,
      "texte": "Hors de question que tu rentres dans ce cirque ridicule !"
    },
    {
      "debut": 31.28,
      "fin": 33.74,
      "texte": "Mais maman, un million d'euros, tu réalises un million juste pour dormir ?"
    },
    {
      "debut": 33.74,
      "fin": 36.14,
      "texte": "Et mes 670 euros de réveil, qui me les rembourse, moi ?"
    },
    {
      "debut": 36.14,
      "fin": 38.36,
      "texte": "Bah, avec le million, je te rembourse tout, et l'argent, en plus !"
    },
    {
      "debut": 39.08,
      "fin": 41.18,
      "texte": "Donne-moi ce stylo, ou je signe, bon sang ?"
    },
    {
      "debut": 41.18,
      "fin": 43.9,
      "texte": "Bienvenue au défi du sommeil le plus dur du monde, en direct !"
    },
    {
      "debut": 43.9,
      "fin": 46.68,
      "texte": "Un million d'euros pour celui qui dormira le plus longtemps !"
    },
    {
      "debut": 46.68,
      "fin": 49.58,
      "texte": "Quatre lits, quatre candidats, et un seul repartira avec le million !"
    },
    {
      "debut": 49.58,
      "fin": 51.7,
      "texte": "Facile, personne au monde dort mieux que moi, personne !"
    },
    {
      "debut": 51.7,
      "fin": 55.22,
      "texte": "Mignon, mais c'est moi qui vais rafler ce million, les amis !"
    },
    {
      "debut": 55.22,
      "fin": 58.34,
      "texte": "Oh non, ma Péchita, dans quelle histoire de fou tu t'es embarquée ?"
    },
    {
      "debut": 58.34,
      "fin": 61.0,
      "texte": "Pourvu qu'elle tienne le coup, ma petite chérie !"
    },
    {
      "debut": 61.0,
      "fin": 64.32,
      "texte": "Première manche, sans réveil en même temps, que le plus gros dormeur du monde gagne !"
    },
    {
      "debut": 64.32,
      "fin": 65.92,
      "texte": "Trop facile, je vais tous les écraser, moi !"
    },
    {
      "debut": 66.36,
      "fin": 69.04,
      "texte": "Les autres veulent le million, moi juste mon oreiller !"
    },
    {
      "debut": 69.04,
      "fin": 71.22,
      "texte": "C'est insupportable, comment dormir là-dedans, c'est impossible !"
    },
    {
      "debut": 71.22,
      "fin": 72.88,
      "texte": "Je craque, j'en peux déjà plus, moi !"
    }
  ],
