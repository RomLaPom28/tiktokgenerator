{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.42,
      "fin": 0.9,
      "texte": "Kiwi ?"
    },
    {
      "debut": 0.9,
      "fin": 1.5,
      "texte": "Oui, Frès, c'est moi."
    },
    {
      "debut": 1.64,
      "fin": 3.0,
      "texte": "J'ai décidé de te montrer qui j'étais réellement,"
    },
    {
      "debut": 3.1,
      "fin": 3.98,
      "texte": "et j'aimerais tout t'expliquer."
    },
    {
      "debut": 4.26,
      "fin": 5.72,
      "texte": "Je m'excuse de t'avoir menti, je suis né squelettique,"
    },
    {
      "debut": 5.76,
      "fin": 6.94,
      "texte": "et il n'y a pas de moyen pour moi de prendre du poids."
    },
    {
      "debut": 7.04,
      "fin": 7.68,
      "texte": "Peu importe ce que je fais,"
    },
    {
      "debut": 7.8,
      "fin": 9.36,
      "texte": "quand je t'ai vu squelettique, je suis tombé fou amoureux de toi,"
    },
    {
      "debut": 9.46,
      "fin": 10.08,
      "texte": "parce que toi tu assumais."
    },
    {
      "debut": 10.16,
      "fin": 12.3,
      "texte": "Tu te rends compte que toute notre relation était basée sur des mensonges ?"
    },
    {
      "debut": 12.94,
      "fin": 13.7,
      "texte": "Je t'ai toujours aimé,"
    },
    {
      "debut": 13.86,
      "fin": 15.16,
      "texte": "et je veux que tu reviennes squelette avec moi."
    },
    {
      "debut": 15.3,
      "fin": 16.8,
      "texte": "Tous ces deux pour toujours, tu m'as trahi en prenant du poids,"
    },
    {
      "debut": 16.88,
      "fin": 17.46,
      "texte": "mais tu peux encore te rattraper."
    },
    {
      "debut": 17.46,
      "fin": 19.14,
      "texte": "Ah ça suffit, Kiwi !"
    },
    {
      "debut": 19.14,
      "fin": 20.56,
      "texte": "Je t'aurais aimé même squelettique,"
    },
    {
      "debut": 20.78,
      "fin": 23.1,
      "texte": "mais tu as choisi de me mentir et de me rabaisser avec tes potes."
    },
    {
      "debut": 23.26,
      "fin": 24.42,
      "texte": "Maintenant c'est fini, je me suis choisi,"
    },
    {
      "debut": 24.46,
      "fin": 26.32,
      "texte": "et je ne reviendrai pas squelettique pour te plaire."
    },
    {
      "debut": 26.78,
      "fin": 29.02,
      "texte": "Alors c'est la guerre, et crois-moi je vais la gagner !"
    },
    {
      "debut": 29.02,
      "fin": 30.76,
      "texte": "Voilà, avec cette fiole, tu reviendras squelettique,"
    },
    {
      "debut": 30.82,
      "fin": 31.98,
      "texte": "et tu vas regretter de m'avoir rejeté."
    },
    {
      "debut": 32.72,
      "fin": 33.84,
      "texte": "Je me sens faible depuis tout à l'heure,"
    },
    {
      "debut": 33.9,
      "fin": 35.0,
      "texte": "et j'ai l'impression de rep perdre du poids,"
    },
    {
      "debut": 35.12,
      "fin": 36.28,
      "texte": "il faut que j'aille consulter un médecin."
    },
    {
      "debut": 36.54,
      "fin": 38.02,
      "texte": "Regardez les mecs, Frès n'a pas l'air bien."
    },
    {
      "debut": 38.34,
      "fin": 39.36,
      "texte": "Je lui manque, j'en suis sûr."
    },
    {
      "debut": 41.84,
      "fin": 43.36,
      "texte": "Écoutez madame, votre prise de sang n'est pas bonne."
    },
    {
      "debut": 43.36,
      "fin": 45.2,
      "texte": "On a retrouvé un produit que vous avez dû boire hier,"
    },
    {
      "debut": 45.3,
      "fin": 46.48,
      "texte": "qui est fait pour amégrir fortement."
    },
    {
      "debut": 46.72,
      "fin": 47.84,
      "texte": "Hier, impossible !"
    },
    {
      "debut": 47.84,
      "fin": 49.44,
      "texte": "À moins que ça soit Kiwi, il n'a pas osé me faire ça."
    },
    {
      "debut": 50.14,
      "fin": 51.76,
      "texte": "Ne vous inquiétez pas, je vous donne tout de suite le remède,"
    },
    {
      "debut": 51.82,
      "fin": 53.56,
      "texte": "et vous devriez porter plainte contre cette personne si c'est avéré."
    },
    {
      "debut": 53.98,
      "fin": 55.86,
      "texte": "Kiwi, on dirait que les gens te regardent trop chelou."
    },
    {
      "debut": 56.1,
      "fin": 58.2,
      "texte": "Ça tombe bien, je dois me trouver une nouvelle meuf pour Dorot."
    },
    {
      "debut": 58.48,
      "fin": 60.9,
      "texte": "Oh mon téléphone vibre, je viens de recevoir un message, je vais regarder."
    },
    {
      "debut": 61.64,
      "fin": 63.36,
      "texte": "Regardez les gars, mais c'est qui ce maigre lait ?"
    },
    {
      "debut": 63.36,
      "fin": 65.04,
      "texte": "On dirait Kiwi, je pense que c'est Kiwi."
    },
    {
      "debut": 65.38,
      "fin": 67.12,
      "texte": "N'importe quoi, c'est de l'IA les gars !"
    },
    {
      "debut": 67.12,
      "fin": 70.66,
      "texte": "Il n'y a qu'un seul moyen de vérifier si tes muscles sont bien réels,"
    },
    {
      "debut": 70.82,
      "fin": 72.16,
      "texte": "alors cette petite pince ne devrait rien faire."
    },
    {
      "debut": 72.38,
      "fin": 73.62,
      "texte": "Arrête gros, je ne te conseille pas de le faire."
    },
    {
      "debut": 74.8,
      "fin": 78.26,
      "texte": "Je pleure et m'en vais !"
    },
    {
      "debut": 78.26,
      "fin": 81.0,
      "texte": "Il mettait un déguisement tout ce temps, comment il a fait pour Dorot avec Fraise ?"
    },
    {
      "debut": 83.27,
      "fin": 85.07,
      "texte": "Contre toi !"
    },
    {
      "debut": 85.07,
      "fin": 87.85,
      "texte": "Au final, c'est toi qui gagneux !"
    },
    {
      "debut": 87.85,
      "fin": 90.25,
      "texte": "Un nouveau chapitre s'ouvre pour moi, loin d'ici."
    }
  ],
