{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 1.5,
      "texte": "Ils voulaient l'argent de mon père ?"
    },
    {
      "debut": 2.78,
      "fin": 4.52,
      "texte": "Alors on va voir s'il reste quand y'en a plus."
    },
    {
      "debut": 4.98,
      "fin": 7.04,
      "texte": "Largue-le direct, Jad ! Il te mérite pas !"
    },
    {
      "debut": 7.04,
      "fin": 9.52,
      "texte": "Non ! D'abord, je veux qu'il montre son vrai visage."
    },
    {
      "debut": 9.96,
      "fin": 12.1,
      "texte": "Yanis, mon père, a tout perdu. On n'a plus rien."
    },
    {
      "debut": 12.28,
      "fin": 14.78,
      "texte": "Tout ? Même la maison ? Même les comptes ?"
    },
    {
      "debut": 14.78,
      "fin": 16.8,
      "texte": "C'est rien, mon cœur. On va s'en sortir."
    },
    {
      "debut": 17.18,
      "fin": 18.98,
      "texte": "Alors tu restes avec moi ?"
    },
    {
      "debut": 18.98,
      "fin": 19.58,
      "texte": "Bien sûr."
    },
    {
      "debut": 20.08,
      "fin": 22.94,
      "texte": "Karim, elle a plus un rond. Ce soir, je la quitte."
    },
    {
      "debut": 23.44,
      "fin": 24.52,
      "texte": "Fini de jouer le gentil."
    },
    {
      "debut": 25.0,
      "fin": 27.02,
      "texte": "Tenez, le croissant est offert. Vous avez l'air triste."
    },
    {
      "debut": 27.22,
      "fin": 29.58,
      "texte": "Pourquoi vous êtes gentil avec moi ? Personne l'est."
    },
    {
      "debut": 29.58,
      "fin": 32.86,
      "texte": "Parce que vous avez le plus beau sourire du quartier."
    },
    {
      "debut": 33.14,
      "fin": 35.1,
      "texte": "Vous dites ça à toutes les clientes ?"
    },
    {
      "debut": 35.1,
      "fin": 37.88,
      "texte": "Jade, c'est fini. Je vais pas vivre avec une fille fauchée."
    },
    {
      "debut": 38.08,
      "fin": 40.06,
      "texte": "Donc c'était que pour l'argent ?"
    },
    {
      "debut": 40.06,
      "fin": 42.58,
      "texte": "Regarde-toi, Jade. Y'avait rien d'autre à aimer."
    },
    {
      "debut": 42.78,
      "fin": 45.78,
      "texte": "Tu vas le regretter, Yanis. Crois-moi, fini le test."
    },
    {
      "debut": 47.18,
      "fin": 49.68,
      "texte": "Demain soir, il va voir qui il a laissé partir."
    },
    {
      "debut": 50.18,
      "fin": 52.44,
      "texte": "Frérot, c'est qui ? La bombe en rouge ?"
    },
    {
      "debut": 52.44,
      "fin": 54.59,
      "texte": "Attends, cette robe, c'est Jade ?"
    },
    {
      "debut": 55.16,
      "fin": 57.8,
      "texte": "Salut Yanis. Je te présente Malik."
    },
    {
      "debut": 57.8,
      "fin": 59.84,
      "texte": "Lui, il m'a aimé avec 150 kilos."
    },
    {
      "debut": 60.26,
      "fin": 62.18,
      "texte": "Jade, attends ! On peut parler ?"
    },
    {
      "debut": 62.18,
      "fin": 64.78,
      "texte": "Trop tard. Le test est terminé."
    }
  ],
