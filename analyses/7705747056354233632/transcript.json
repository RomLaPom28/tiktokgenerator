{
  "langue": "fr",
  "phrases": [
    {
      "debut": 0.0,
      "fin": 2.58,
      "texte": "Hé Petit ! Tu vas te tuer ! Descends de là !"
    },
    {
      "debut": 2.58,
      "fin": 4.68,
      "texte": "T'inquiète papi, j'attends juste ma pizza."
    },
    {
      "debut": 5.04,
      "fin": 7.18,
      "texte": "Mais qu'est-ce qu'il a dans la tête lui ?"
    },
    {
      "debut": 7.18,
      "fin": 9.08,
      "texte": "Ça fait 30 minutes qu'il est accroché à la barre."
    },
    {
      "debut": 9.34,
      "fin": 11.12,
      "texte": "Petit, il y a plein de places assises !"
    },
    {
      "debut": 11.12,
      "fin": 12.8,
      "texte": "Je sais, mais accroché je suis mieux."
    },
    {
      "debut": 13.16,
      "fin": 15.52,
      "texte": "Attends, 30 minutes accrochées sans trembler ?"
    },
    {
      "debut": 15.52,
      "fin": 16.9,
      "texte": "Ouais, c'est même confortable."
    },
    {
      "debut": 17.32,
      "fin": 18.72,
      "texte": "Petit, t'es un génie !"
    },
    {
      "debut": 18.72,
      "fin": 20.6,
      "texte": "Championnat du monde d'accroche, 1 million d'euros !"
    },
    {
      "debut": 20.6,
      "fin": 22.34,
      "texte": "1 million juste pour rester accroché ?"
    },
    {
      "debut": 22.34,
      "fin": 23.4,
      "texte": "Marché conclu coach."
    },
    {
      "debut": 23.6,
      "fin": 26.12,
      "texte": "Bienvenue au championnat du monde d'accroche !"
    },
    {
      "debut": 26.12,
      "fin": 28.36,
      "texte": "Hé le petit, contre moi t'as aucune chance."
    },
    {
      "debut": 28.6,
      "fin": 29.82,
      "texte": "Et toi t'es qui le grand ?"
    },
    {
      "debut": 29.82,
      "fin": 31.06,
      "texte": "Je m'appelle Jean."
    },
    {
      "debut": 31.46,
      "fin": 32.62,
      "texte": "Jean Peuplu."
    },
    {
      "debut": 32.92,
      "fin": 35.0,
      "texte": "Jean Peuplu ? C'est quoi ce nom ?"
    },
    {
      "debut": 36.22,
      "fin": 36.74,
      "texte": "Partez !"
    },
    {
      "debut": 36.74,
      "fin": 39.08,
      "texte": "Dans 20 minutes, tu finis dans la scène."
    },
    {
      "debut": 39.8,
      "fin": 41.12,
      "texte": "Je pourrais rester là toute la journée."
    },
    {
      "debut": 41.48,
      "fin": 43.08,
      "texte": "Hé le grand, tu trembles là ?"
    },
    {
      "debut": 43.08,
      "fin": 43.82,
      "texte": "Je tremble pas."
    },
    {
      "debut": 44.12,
      "fin": 45.4,
      "texte": "T'en veux une gorgée ?"
    },
    {
      "debut": 45.4,
      "fin": 47.06,
      "texte": "Comment tu fais pour être aussi tranquille ?"
    },
    {
      "debut": 47.06,
      "fin": 49.32,
      "texte": "Je suis juste accroché, j'ai même pas commencé à forcer."
    },
    {
      "debut": 49.64,
      "fin": 50.7,
      "texte": "Jean Peuplu."
    },
    {
      "debut": 51.06,
      "fin": 52.44,
      "texte": "Ah bah il porte bien son nom."
    },
    {
      "debut": 54.42,
      "fin": 56.16,
      "texte": "Incroyable, nous avons un vainqueur !"
    },
    {
      "debut": 56.16,
      "fin": 57.66,
      "texte": "Alors, il est où mon million ?"
    },
    {
      "debut": 57.66,
      "fin": 58.7,
      "texte": "Doucement champion."
    },
    {
      "debut": 58.7,
      "fin": 61.26,
      "texte": "Tu dois encore affronter le haricot vert,"
    },
    {
      "debut": 61.64,
      "fin": 63.32,
      "texte": "l'homme qui n'est jamais tombé."
    },
    {
      "debut": 63.5,
      "fin": 64.8,
      "texte": "Jamais ? Jamais ?"
    },
    {
      "debut": 64.8,
      "fin": 66.06,
      "texte": "Pas une seule fois."
    }
  ],
